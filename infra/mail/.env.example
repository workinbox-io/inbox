# Verified by scripts/test-jmap-engine.mjs; upgrade only after rerunning it.
STALWART_IMAGE=stalwartlabs/stalwart@sha256:f772aa6ef8cd8018969fa491640f1436b0270eb14e2c219b5f37f1a77020837e
MAIL_MEMORY_LIMIT=1g
MAIL_CPU_LIMIT=1.0
MAIL_BRIDGE_TOKEN=
MAIL_BRIDGE_KEY=
# Operator-only one-shot engine index pilot; no background sync is enabled yet.
MAIL_ENGINE_URL=
MAIL_ENGINE_TOKEN=
MAIL_ENGINE_SCOPE=
MAIL_ENGINE_ACCOUNT_ID=
MAIL_SYNC_ENABLED=false
MAIL_SEND_ENABLED=false
MAIL_ENGINE_DOMAIN_ID=
MAIL_ENGINE_DOMAIN=
MAIL_ENGINE_IMAP_HOST=
MAIL_ENGINE_IMAP_TARGET=stalwart

# Set only after exposing tested IMAPS with a trusted certificate.
MAIL_CLIENT_IMAP_HOST=
# Override the default pair when client and private engine hostnames differ.
MAIL_CLIENT_TLS_KEY=/run/mail-tls/privkey.pem
MAIL_CLIENT_TLS_CERT=/run/mail-tls/fullchain.pem
# Optional previous client certificate for existing clients, selected by TLS SNI.
MAIL_CLIENT_TLS_LEGACY_KEY=
MAIL_CLIENT_TLS_LEGACY_CERT=

# Workinbox rechecks membership before sending and every 30s for native clients.
MAIL_AUTHORIZATION_URL=https://workinbox.io/api/internal/mail-bridge/authorize

MAIL_HOSTED_ENABLED=false

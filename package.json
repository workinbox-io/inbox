{
  "name": "saas-template",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler d1 migrations apply DB --remote && wrangler deploy && node scripts/indexnow.ts",
    "typecheck": "wrangler types --strict-vars=false && astro sync && tsc --noEmit",
    "test": "vitest run",
    "cf-types": "wrangler types --strict-vars=false",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "setup": "node scripts/setup.ts",
    "indexnow": "node scripts/indexnow.ts",
    "paddle:sync": "node --env-file=.dev.vars scripts/paddle-sync.ts",
    "template:update": "sh scripts/template-update.sh"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.2",
    "@astrojs/react": "^7.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "@better-auth/cimd": "^1.7.14",
    "@better-auth/mcp": "^1.7.14",
    "@better-auth/oauth-provider": "^1.7.14",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/core": "^2.4.0",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/server": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^9.3.1",
    "astro": "7.4.2",
    "better-auth": "^1.7.14",
    "boring-avatars": "^2.0.4",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "gsap": "3.15.0",
    "lucide-react": "^1.61.0",
    "next-themes": "^0.4.6",
    "postal-mime": "^4.1.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.3",
    "react-resizable-panels": "^4.15.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "uqr": "^0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}

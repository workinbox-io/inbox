{
  "name": "inbox",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "shots": "node scripts/marketing-shots.ts",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler d1 migrations apply DB --remote && wrangler deploy && node scripts/indexnow.ts",
    "typecheck": "wrangler types --strict-vars=false && astro sync && tsc --noEmit",
    "test": "vitest run",
    "cf-types": "wrangler types --strict-vars=false",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "setup": "node scripts/setup.ts",
    "indexnow": "node scripts/indexnow.ts",
    "paddle:sync": "node --env-file=.dev.vars scripts/paddle-sync.ts",
    "template:update": "sh scripts/template-update.sh"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  },

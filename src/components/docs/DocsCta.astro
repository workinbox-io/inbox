---
import { buttonVariants } from "@/components/ui/button";
import { cn } from "cn";
import { TRIAL_DAYS } from "@/config/plans";
import { siteConfig } from "@/config/site";
import { siteLocale, tFor, lp } from "@/lib/i18n/site";
const locale = siteLocale(Astro.url);
const t = tFor(locale);
---

<div class="bg-surface text-surface-foreground flex flex-col gap-2 rounded-md p-6 text-sm">
  <div class="text-base leading-tight font-medium tracking-tight text-balance">{t("Try {name} free.", { name: siteConfig.name })}</div>
  <div class="text-muted-foreground">{t("Start a free {days}-day trial. No credit card needed.", { days: TRIAL_DAYS })}</div>
  <div class="flex flex-wrap gap-2">
    <a href="/signup" class={cn(buttonVariants({ size: "sm" }), "mt-2")}>
      {t("Start free trial")}
    </a>
    <a href={lp(locale, "/pricing")} class={cn(buttonVariants({ size: "sm", variant: "outline" }), "mt-2")}>
      {t("Pricing")}
    </a>
  </div>
</div>

---
// The app icon (/logo.svg, same as the favicon and the app rail) and the wordmark, set like Navy's. Size it with a text-* class, colour it with text-*.
import { siteConfig } from "@/config/site";
const { class: className, ...rest } = Astro.props;
---

<span class:list={["inline-flex items-center gap-[0.45em] font-semibold uppercase tracking-tight leading-none whitespace-nowrap", className]} {...rest}>
  <img src="/logo.svg" alt="" width="28" height="28" class="size-[1.4em] shrink-0 rounded-[0.3em] ring-1 ring-current/15" />
  {siteConfig.name}
</span>

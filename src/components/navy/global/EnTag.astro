---
// A small "EN" after a link whose page has no version in the visitor's language (the link still works).
import { isUntranslated, siteLocale, tFor } from "@/lib/i18n/site";
const { href } = Astro.props;
const locale = siteLocale(Astro.url);
const show = isUntranslated(locale, href);
---

{show && (<><span aria-hidden="true" class="ml-1 text-xs font-normal opacity-60">(EN)</span><span class="sr-only">, {tFor(locale)("in English")}</span></>)}

---
/** The closing ink band of every marketing page, flowing into the footer: a title, the command box, buttons, the pier. */
import CommandBox from "./CommandBox.astro";
import PixelScene from "./pixel/PixelScene.astro";
import { siteLocale, tFor } from "@/lib/i18n/site";

interface Props {
  title?: string;
  text?: string;
}
const t = tFor(siteLocale(Astro.url));
const { title = "Bring your domain", text = "Your team's mail, chat, notes and files on it this afternoon." } = Astro.props;
---

<section class="mk-band">
  <div class="mk-wrap grid items-center gap-10 pt-20 sm:pt-28 lg:grid-cols-2">
    <div>
      <h2 class="mk-h2">{t(title)}</h2>
      <p class="mk-lead mt-3">{t(text)}</p>
    </div>
    <div>
      <CommandBox />
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/signup" class="mk-btn">{t("Start free")}</a>
        <a href="/docs" class="mk-btn mk-btn-ghost">{t("Read the docs")}</a>
      </div>
    </div>
  </div>
  <div class="mt-10"><PixelScene scene="cta" /></div>
</section>

---
/** The Hosted / Self-host box: mono tabs over one command line, with copy for the self-host one (boat.dev's install box). */
import { siteConfig } from "@/config/site";
import { siteLocale, tFor } from "@/lib/i18n/site";

interface Props {
  /** Show the trial note after the hosted command. */
  hint?: boolean;
  class?: string;
}
const { hint = false, class: className } = Astro.props;
const t = tFor(siteLocale(Astro.url));
---

<div class:list={["mk-cmd", className]} data-cmd>
  <div role="tablist" aria-label={t("How to start")}>
    <button type="button" role="tab" aria-selected="true" data-cmd-tab="hosted">{t("Hosted")}</button>
    <button type="button" role="tab" aria-selected="false" tabindex="-1" data-cmd-tab="self">{t("Self-host")}</button>
  </div>
  <div class="mk-cmd-line" data-cmd-panel="hosted">
    <span><span class="opacity-50">$</span> open workinbox.io/signup{hint && <span class="opacity-50"> # {t("free for up to 5 people")}</span>}</span>
    <a href="/signup">{t("start →")}</a>
  </div>
  <div class="mk-cmd-line" data-cmd-panel="self" hidden>
    <span data-copy-text><span class="opacity-50">$</span> git clone {siteConfig.repoUrl}.git && cd inbox && pnpm install && pnpm run setup</span>
    <button type="button" data-copy data-done={t("copied")} data-label={t("copy")}>{t("copy")}</button>
  </div>
</div>

<script>
  for (const box of document.querySelectorAll<HTMLElement>("[data-cmd]")) {
    const tabs = [...box.querySelectorAll<HTMLButtonElement>("[data-cmd-tab]")];
    const select = (tab: HTMLButtonElement) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        box.querySelector<HTMLElement>(`[data-cmd-panel="${t.dataset.cmdTab}"]`)!.hidden = !on;
      }
    };
    tabs.forEach((tab, n) => {
      tab.addEventListener("click", () => select(tab));
      tab.addEventListener("keydown", (e) => {
        if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
        const next = tabs[(n + (e.key === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length]!;
        select(next);
        next.focus();
      });
    });
    box.querySelector<HTMLButtonElement>("[data-copy]")?.addEventListener("click", async (e) => {
      const button = e.currentTarget as HTMLButtonElement;
      const text = box.querySelector("[data-copy-text]")!.textContent!.replace(/^\s*\$\s*/, "").trim();
      await navigator.clipboard.writeText(text).catch(() => {});
      button.textContent = button.dataset.done ?? "copied";
      setTimeout(() => (button.textContent = button.dataset.label ?? "copy"), 1500);
    });
  }
</script>

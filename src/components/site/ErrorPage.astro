---
import { siteConfig } from "@/config/site";
import { buttonVariants } from "@/components/ui/button";
import MarketingLayout from "@/layouts/MarketingLayout.astro";

interface Props {
  code: number;
  title: string;
  message: string;
}
const { code, title, message } = Astro.props;
---

<MarketingLayout title={title} description={message}>
  <section class="mx-auto flex w-full max-w-xl flex-1 flex-col items-center justify-center gap-5 px-4 py-24 text-center">
    <span class="eyebrow text-muted-foreground">Error {code}</span>
    <p class="text-primary text-7xl font-medium tracking-tight tabular-nums sm:text-8xl" aria-hidden="true">{code}</p>
    <h1 class="text-3xl font-medium tracking-tight text-balance sm:text-4xl">{title}</h1>
    <p class="text-muted-foreground text-pretty">{message}</p>
    <div class="mt-3 flex flex-wrap items-center justify-center gap-3">
      <a href="/" class={buttonVariants({ size: "lg" })}>Back to home</a>
      <a href="/app" class={buttonVariants({ size: "lg", variant: "secondary" })}>Dashboard</a>
    </div>
    <p class="text-muted-foreground mt-2 text-sm">
      Need a hand? See the <a href="/docs" class="hover:text-foreground underline underline-offset-2">docs</a> or write to
      <a href={`mailto:${siteConfig.supportEmail}`} class="hover:text-foreground underline underline-offset-2">{siteConfig.supportEmail}</a>.
    </p>
  </section>
</MarketingLayout>

---
/** Questions as native <details> rows between hairlines, a mono + / − in front. */
interface Props {
  items: { question: string; answer: string }[];
}
const { items } = Astro.props;
---

<div class="border-t border-(--border)">
  {
    items.map((item, i) => (
      <details name="faq" open={i === 0} class="group border-b border-(--border)">
        <summary class="flex cursor-pointer list-none items-start gap-4 py-5 text-lg outline-none focus-visible:underline [&::-webkit-details-marker]:hidden">
          <span class="mk-mono w-4 shrink-0 text-(--muted-foreground) group-open:hidden" aria-hidden="true">+</span>
          <span class="mk-mono hidden w-4 shrink-0 text-(--muted-foreground) group-open:inline" aria-hidden="true">−</span>
          <span class="flex-1 font-medium text-balance">{item.question}</span>
        </summary>
        <p class="pb-6 pl-8 leading-7 text-pretty text-(--muted-foreground)">{item.answer}</p>
      </details>
    ))
  }
</div>

---
/** One soft surface, each question a native <details> row. */
interface Props {
  items: { question: string; answer: string }[];
}
const { items } = Astro.props;
---

<div class="bg-surface text-card-foreground divide-border/60 divide-y overflow-hidden rounded-[28px]">
  {
    items.map((item, index) => (
      <details name="faq" open={index === 0} class="group">
        <summary class="focus-visible:bg-muted/25 flex min-h-[54px] w-full cursor-pointer list-none items-center gap-4 px-5 py-3 text-left text-base tracking-tight outline-none transition-colors [&::-webkit-details-marker]:hidden">
          <span class="flex-1 text-balance">{item.question}</span>
          <svg class="text-muted-foreground size-4 shrink-0 transition-transform duration-300 group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg>
        </summary>
        <div class="faq-answer"><p class="text-muted-foreground px-5 pb-5 text-[15px] leading-6 tracking-tight text-pretty">{item.answer}</p></div>
      </details>
    ))
  }
</div>

<style>
  details::details-content {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 250ms ease, content-visibility 250ms allow-discrete;
  }

  details[open]::details-content {
    grid-template-rows: 1fr;
  }

  .faq-answer {
    min-height: 0;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    details::details-content {
      transition: none;
    }
  }
</style>

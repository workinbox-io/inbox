---
import PixelIcon from "./pixel/PixelIcon.astro";

interface Props {
  class?: string;
  /** The red pixel post box (header and footer of the marketing site), instead of the app icon. */
  pixel?: boolean;
}
const { class: className = "size-7", pixel = false } = Astro.props;

/**
 * Our post box in pixels: lit from the left, a dark cap and foot, a letter with a blue stamp in the slot, a gold plate.
 * Red on purpose: it reads on the white page and on the ink bands alike.
 */
const MARK = [
  "......RRRR......",
  "....hRRRRRRr....",
  "...hRRRRRRRRr...",
  "..hRRRRRRRRRRr..",
  ".dddddddddddddd.",
  "..hRRwwwwwsRRr..",
  "..hRkwwwwwwkRr..",
  "..hRRRRRRRRRRr..",
  "..hRRRyyyyRRRr..",
  "..hRRRyRRyRRRr..",
  "..hRRRyyyyRRRr..",
  "..hRRRRRRRRRRr..",
  "..hRRRRRRRRRRr..",
  "..hRRRRRRRRRRr..",
  ".dddddddddddddd.",
  "dddddddddddddddd",
];
const COLORS = { R: "#d6402f", h: "#ef7a63", r: "#a92c1f", d: "#7c1f16", y: "#e9b949", w: "#fefefe", s: "#2f6fd6", k: "#3a0f0a" };
---

{pixel ? <PixelIcon rows={MARK} colors={COLORS} class={className} /> : <img src="/logo.svg" alt="" width="28" height="28" class:list={[className]} />}

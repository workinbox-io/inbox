---
/** The opening ink band of a marketing page (use with MarketingLayout `ink`): left-aligned content over the living-room strip
 * (pixel scene "house"), the same as the home page. */
import PixelScene from "./pixel/PixelScene.astro";
---

<section class="mk-band mk-under-header overflow-hidden">
  <div class="mk-wrap pt-8 sm:pt-12">
    <slot />
  </div>
  <!-- Phones show the strip's middle (the table), twice as large. -->
  <div class="mt-8 sm:mt-10">
    <PixelScene scene="house" class="max-md:-ml-[50%] max-md:w-[200%]!" />
  </div>
</section>

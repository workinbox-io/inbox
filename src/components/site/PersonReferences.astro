---
import { UserAvatar } from "@/components/app/user-avatar";
import { personReferences } from "@/lib/marketing-people";

interface Props { text: string }
---

{personReferences(Astro.props.text).map(({ label, seed }) => seed ? (
  <span class="person-pill mk-round"><UserAvatar seed={seed} size={20} /><span>{label}</span></span>
) : label)}

<style>
  .person-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    padding: 0.18em 0.55em 0.18em 0.2em;
    margin-block: 0.15em;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: #fff;
    color: #141414;
    font-size: 0.9em;
    line-height: 1.25;
    vertical-align: middle;
    white-space: nowrap;
    text-transform: none;
    letter-spacing: normal;
  }
</style>

---
/** Plan cards from config/plans.ts, used on the home page and /pricing, plus the self-hosted line under them. */
import { ArrowRight, Check, Server } from "lucide-react";
import { FREE_NOTE, PLAN_LIST, POPULAR_PLAN, PRICE_UNIT, planFeatures, priceYearly } from "@/config/plans";

interface Props {
  /** Show the yearly price under the monthly one. */
  yearly?: boolean;
}
import { formatMoney } from "@/lib/i18n/format";
import { siteLocale, tFor } from "@/lib/i18n/site";
const { yearly = false } = Astro.props;
const locale = siteLocale(Astro.url);
const t = tFor(locale);
const money = (cents: number) => formatMoney(locale, cents);
---

<div class="grid gap-4 sm:gap-5 lg:grid-cols-3">
  {
    PLAN_LIST.map((p) => (
      <div data-reveal-item class="price-card flex flex-col p-6 sm:p-8" data-popular={String(p.id === POPULAR_PLAN)}>
        <div class="flex items-center justify-between">
          <span class="text-sm font-semibold">{p.name}</span>
          {p.id === POPULAR_PLAN ? <span class="rounded-full bg-foreground px-2.5 py-0.5 text-xs font-medium text-background">{t("Most popular")}</span> : null}
        </div>
        <p class="mt-6 flex items-baseline gap-2">
          <span class="font-display text-6xl tabular-nums">{money(p.priceMonthly)}</span>
          <span class="text-sm text-foreground/60">{t(PRICE_UNIT)}</span>
        </p>
        <p class="mt-1 text-sm text-foreground/60">{t(FREE_NOTE)}{yearly ? t(", or {price} a year with two months free", { price: money(priceYearly(p)) }) : ""}</p>
        <ul class="mt-6 flex-1 space-y-2.5 text-sm">
          {planFeatures(p).map((f) => (
            <li class="flex items-start gap-2.5">
              <Check className="mt-0.5 size-4 shrink-0" />
              <span>
                {t(f.label)}
                {f.soon ? <span class="ml-1.5 rounded-full border border-(--border) px-1.5 py-px text-[11px] text-foreground/60">{t("Soon")}</span> : null}
              </span>
            </li>
          ))}
        </ul>
        <a href="/signup" class:list={["mk-btn mt-8 w-full", p.id !== POPULAR_PLAN && "mk-btn-ghost"]}>
          {t("Start free trial")}
        </a>
      </div>
    ))
  }
</div>
<a href="/docs/self-host" class="mt-5 flex flex-col gap-3 rounded-2xl border border-dashed border-(--border) p-5 transition-colors hover:bg-(--accent) sm:flex-row sm:items-center sm:p-6">
  <Server className="size-5 shrink-0" />
  <span class="flex-1">
    <b class="font-semibold">{t("Self-hosted: free.")}</b>
    <span class="text-foreground/65"> {t("The same app on your own Cloudflare account. Open source, every feature, you pay Cloudflare for what you use.")}</span>
  </span>
  <span class="inline-flex items-center gap-1.5 text-sm font-medium">{t("How to deploy")} <ArrowRight className="size-4" /></span>
</a>

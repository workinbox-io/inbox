---
/** The plans from config/plans.ts as Navy's plan columns, with self-hosting as the last one. Used on /pricing. */
import Text from "@/components/navy/fundations/elements/Text.astro";
import Button from "@/components/navy/fundations/elements/Button.astro";
import Check from "@/components/navy/fundations/icons/Check.astro";
import { FREE_NOTE, PLAN_LIST, POPULAR_PLAN, PRICE_UNIT, planFeatures, priceYearly } from "@/config/plans";
import { formatMoney } from "@/lib/i18n/format";
import { siteLocale, tFor } from "@/lib/i18n/site";
interface Props {
  /** Show the yearly price under the monthly one. */
  yearly?: boolean;
}
const { yearly = false } = Astro.props;
const locale = siteLocale(Astro.url);
const t = tFor(locale);
const money = (cents: number) => formatMoney(locale, cents);
---

<ul role="list" class="grid gap-16 sm:grid-cols-2 sm:gap-8 lg:grid-cols-4">
  {
    PLAN_LIST.map((p) => (
      <li class="flex flex-col">
        <div class="flex items-baseline gap-3">
          <Text tag="h2" variant="textBase" class="font-medium text-foreground">{p.name}</Text>
          {p.id === POPULAR_PLAN && <Text tag="span" variant="textXS" class="text-primary">{t("Most popular")}</Text>}
        </div>
        <p class="flex items-baseline gap-1.5 mt-16 lg:mt-24">
          <Text tag="span" variant="displayLG" class="tracking-tight text-foreground tabular-nums">{money(p.priceMonthly)}</Text>
          <Text tag="span" variant="textSM" class="text-muted-foreground">{t(PRICE_UNIT)}</Text>
        </p>
        <Text tag="p" variant="textSM" class="mt-3 text-muted-foreground text-pretty">
          {t(FREE_NOTE)}{yearly ? t(", or {price} a year with two months free", { price: money(priceYearly(p)) }) : ""}
        </Text>
        <ul role="list" class="flex flex-col mt-10 gap-4">
          {planFeatures(p).map((f) => (
            <li class="flex items-start gap-3">
              <Check size="sm" class="mt-0.5 shrink-0 text-primary" aria-hidden="true" />
              <Text tag="p" variant="textSM" class="text-foreground text-pretty">
                {t(f.label)}
                {f.soon && <span class="ml-1 text-xs uppercase text-muted-foreground">{t("Soon")}</span>}
              </Text>
            </li>
          ))}
        </ul>
        <div class="pt-10 mt-auto">
          <Button isLink={true} href="/signup" size="base" variant={p.id === POPULAR_PLAN ? "accent" : "muted"} class="w-full">
            {t("Start free trial")}
          </Button>
        </div>
      </li>
    ))
  }
  <li class="flex flex-col">
    <Text tag="h2" variant="textBase" class="font-medium text-foreground">{t("Self-hosted")}</Text>
    <p class="mt-16 lg:mt-24">
      <Text tag="span" variant="displayLG" class="tracking-tight text-foreground">{money(0)}</Text>
    </p>
    <Text tag="p" variant="textSM" class="mt-3 text-muted-foreground text-pretty">
      {t("The same app on your own Cloudflare account. Open source, every feature, you pay Cloudflare for what you use.")}
    </Text>
    <div class="pt-10 mt-auto">
      <Button isLink={true} href="/docs/self-host" size="base" variant="muted" class="w-full">{t("How to deploy")}</Button>
    </div>
  </li>
</ul>

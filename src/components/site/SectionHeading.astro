---
/** Big display section title: the first half in ink, the second half muted. Reveals by line (data-split). */
interface Props {
  muted?: string;
  class?: string;
  /** Left aligned instead of centered. */
  left?: boolean;
}
const { muted, class: className, left = false } = Astro.props;
---

<h2
  data-split
  class:list={["max-w-5xl text-[clamp(1.9rem,3.6vw,3.1rem)] leading-[1.08] text-balance", left ? "text-left" : "mx-auto text-center", className]}
>
  <slot />{muted ? <> <span class="text-(--mk-soft-ink)">{muted}</span></> : null}
</h2>

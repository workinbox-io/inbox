---
/** A screen of the app (public/marketing/<name>.webp, made by `pnpm shots`), square and framed by a hairline like Navy's
 * images. The site is light only, so only the light screen loads. */
interface Props {
  name: string;
  alt: string;
  eager?: boolean;
  class?: string;
}
const { name, alt, eager = false, class: className } = Astro.props;
---

<img src={`/marketing/${name}.webp`} alt={alt} width="2880" height="1800" loading={eager ? "eager" : "lazy"} decoding="async" class:list={["block w-full border border-border bg-muted", className]} />

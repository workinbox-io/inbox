---
/**
 * A screen of the app in both themes: public/marketing/<name>.webp in light, <name>-dark.webp in dark (both made by
 * `pnpm shots`). Only the visible one loads (the other is display:none, and lazy).
 */
interface Props {
  name: string;
  alt: string;
  eager?: boolean;
  class?: string;
}
const { name, alt, eager = false, class: className } = Astro.props;
const loading = eager ? "eager" : "lazy";
---

<img src={`/marketing/${name}.webp`} alt={alt} width="2880" height="1800" loading={loading} decoding="async" class:list={["block dark:hidden", className]} />
<img src={`/marketing/${name}-dark.webp`} alt={alt} width="2880" height="1800" loading={loading} decoding="async" class:list={["hidden dark:block", className]} />

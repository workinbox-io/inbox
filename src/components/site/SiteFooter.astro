---
import { siteConfig } from "@/config/site";
import Logo from "./Logo.astro";

/** Footer link columns; edit freely. */
const columns = [
  {
    label: "Product",
    links: [
      { href: "/#features", label: "Features" },
      { href: "/shared-mailbox", label: "Shared mailboxes" },
      { href: "/google-workspace-alternative", label: "Google Workspace alternative" },
      { href: "/vs", label: "Comparisons" },
      { href: "/pricing", label: "Pricing" },
    ],
  },
  {
    label: "Docs",
    links: [
      { href: "/docs", label: "Introduction" },
      { href: "/docs/quickstart", label: "Quickstart" },
      { href: "/docs/self-host", label: "Self-hosting" },
      { href: "/docs/mcp", label: "AI apps" },
      { href: "/docs/api", label: "API" },
    ],
  },
  {
    label: "Company",
    links: [
      { href: "/#faq", label: "FAQ" },
      { href: `mailto:${siteConfig.supportEmail}`, label: "Support" },
      { href: siteConfig.repoUrl, label: "Source code" },
      { href: "/login", label: "Sign in" },
    ],
  },
];
---

<footer class="relative">
  <div class="container-page">
    <div class="grid gap-10 py-14 sm:grid-cols-2 sm:gap-8 lg:grid-cols-[2fr_repeat(3,1fr)]">
      <div>
        <a href="/" class="flex items-center gap-2">
          <Logo />
          <span class="text-base font-medium tracking-tight">{siteConfig.name}</span>
        </a>
        <p class="text-muted-foreground mt-3 max-w-xs text-sm leading-6">{siteConfig.description}</p>
      </div>
      {
        columns.map((column) => (
          <nav aria-label={column.label}>
            <h3 class="text-foreground text-sm font-medium tracking-tight">{column.label}</h3>
            <ul class="mt-4 space-y-2.5">
              {column.links.map((link) => (
                <li>
                  <a href={link.href} class="text-muted-foreground hover:text-foreground inline-flex items-center gap-2 text-sm transition-colors">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
    <div
      class="border-border text-muted-foreground flex flex-col items-start justify-between gap-2 border-t py-5 text-xs sm:flex-row sm:items-center"
    >
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <p>© {new Date().getFullYear()} {siteConfig.legal.brand}</p>
        <a href="/privacy" class="hover:text-foreground transition-colors">Privacy</a>
        <a href="/terms" class="hover:text-foreground transition-colors">Terms</a>
        <a href="/refunds" class="hover:text-foreground transition-colors">Refunds</a>
      </div>
    </div>
  </div>
</footer>

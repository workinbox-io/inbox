---
import { siteConfig } from "@/config/site";
import { APPS } from "@/config/apps";
import { COMPETITORS } from "@/config/compare";
import Logo from "./Logo.astro";
import { localeName, localizedPath, stripLocale } from "@/lib/i18n/locales";
import { lp, pageLocales, siteLocale, tFor } from "@/lib/i18n/site";
import { pagePath } from "@/lib/page-path";

const locale = siteLocale(Astro.url);
const t = tFor(locale);
const here = stripLocale(pagePath(Astro.url.pathname)).path;
const versions = pageLocales(here);

/** Footer link columns; edit freely. */
const columns = [
  {
    label: "Product",
    links: [
      ...APPS.map((a) => ({ href: `/${a.slug}`, label: a.label })),
      { href: "/shared-mailbox", label: "Shared mailboxes" },
      { href: "/google-workspace-alternative", label: "Google Workspace alternative" },
      { href: "/cloudflare-email-routing", label: "Cloudflare Email Routing inbox" },
      { href: "/self-hosted", label: "Self-hosted email" },
      { href: "/pricing", label: "Pricing" },
      { href: "/login", label: "Sign in" },
    ],
  },
  {
    label: "Docs",
    links: [
      { href: "/docs", label: "Introduction" },
      { href: "/docs/quickstart", label: "Quickstart" },
      { href: "/docs/self-host", label: "Self-hosting" },
      { href: "/docs/mcp", label: "AI apps" },
      { href: "/docs/api", label: "API" },
    ],
  },
  {
    label: "Company",
    links: [
      { href: "/#faq", label: "FAQ" },
      { href: `mailto:${siteConfig.supportEmail}`, label: "Support" },
      { href: siteConfig.repoUrl, label: "Source code" },
      { href: "/status", label: "Status" },
      { href: "/security", label: "Security" },
      { href: "/privacy", label: "Privacy" },
      { href: "/terms", label: "Terms" },
      { href: "/refunds", label: "Refunds" },
    ],
  },
];

/** The status bar at the bottom, like a terminal multiplexer's: numbered windows to the places people go next. */
const windows = [
  { href: "/docs", label: "docs" },
  { href: "/docs/api", label: "api" },
  { href: "/docs/self-host", label: "self-host" },
  { href: siteConfig.repoUrl, label: "github" },
];
---

<footer class="site-footer">
  <div class="mk-wrap grid gap-10 py-14 sm:py-16 lg:grid-cols-[1.3fr_repeat(3,1fr)_2fr] lg:gap-8">
    <div>
      <a href={lp(locale, "/")} class="flex items-center gap-2" aria-label={siteConfig.name}>
        <Logo class="size-10" />
        <span class="footer-wordmark">{siteConfig.name}</span>
      </a>
      <p class="footer-muted mt-4 max-w-xs text-sm leading-6">{t(siteConfig.description)}</p>
      {versions.length > 1 && (
        <p class="footer-muted mt-4 flex gap-3 text-sm" aria-label={t("Language")}>
          {versions.map((l) => l === locale ? <span class="text-white" aria-current="true">{localeName(l)}</span> : <a href={localizedPath(l, here)} hreflang={l} lang={l} class="footer-link">{localeName(l)}</a>)}
        </p>
      )}
    </div>
    {
      columns.map((column) => (
        <nav aria-label={t(column.label)}>
          <h3 class="footer-label">{t(column.label)}</h3>
          <ul class="mt-4 space-y-2">
            {column.links.map((link) => (
              <li>
                <a href={lp(locale, link.href)} class="footer-link inline-flex items-center gap-2">
                  {t(link.label)}
                  {link.href === "/status" ? (
                    <span data-status-dot data-state="unknown" class="relative inline-flex size-2" aria-hidden="true">
                      <span class="status-ping absolute inline-flex size-full rounded-full opacity-60 motion-safe:animate-ping" />
                      <span class="status-core relative inline-flex size-2 rounded-full" />
                    </span>
                  ) : null}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
    <nav aria-label={t("Comparisons")}>
      <h3 class="footer-label">{t("Compare {name}", { name: siteConfig.name })}</h3>
      <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-2">
        {COMPETITORS.map((c) => <li><a href={`/vs/${c.slug}`} class="footer-link">vs {c.name}</a></li>)}
        <li><a href="/vs" class="footer-link">{t("All comparisons")}</a></li>
      </ul>
    </nav>
  </div>
  <div class="footer-bar">
    <div class="mk-wrap flex h-8 items-center justify-between gap-4">
      <ul class="flex min-w-0 items-center gap-1 overflow-x-auto">
        <li><a href={lp(locale, "/")} class="footer-window is-on">[inbox]</a></li>
        {windows.map((w, i) => <li><a href={w.href} class="footer-window">{i}:{w.label}</a></li>)}
      </ul>
      <p class="footer-muted shrink-0 whitespace-nowrap">© {new Date().getFullYear()} {siteConfig.legal.brand} · <span data-footer-clock>EU</span></p>
    </div>
  </div>
</footer>

<script>
  // Colours the footer's status dot from the live status page data.
  const dots = document.querySelectorAll<HTMLElement>("[data-status-dot]");
  if (dots.length) {
    fetch("/api/status")
      .then((r) => (r.ok ? r.json() : null))
      .then((data: { status?: string } | null) => {
        const state = data && ["ok", "degraded", "down"].includes(data.status ?? "") ? data.status! : "unknown";
        dots.forEach((d) => (d.dataset.state = state));
      })
      .catch(() => {});
  }
</script>

<script>
  // The status bar's clock, in the visitor's time.
  const clock = document.querySelector<HTMLElement>("[data-footer-clock]");
  if (clock) {
    const tick = () => (clock.textContent = new Intl.DateTimeFormat(undefined, { hour: "2-digit", minute: "2-digit" }).format(new Date()));
    tick();
    setInterval(tick, 30_000);
  }
</script>

<style>
  /* Ink band, also on pages outside .mk (docs, legal), hence the fallbacks. */
  .site-footer {
    color: #fefefe;
    background: var(--mk-band, #141414);
    font-family: var(--mk-font-text, inherit);
  }
  .footer-wordmark {
    font-family: var(--mk-font-display, inherit);
    font-size: 1.9rem;
    font-weight: 600;
    letter-spacing: -0.04em;
  }
  .footer-muted {
    color: rgb(254 254 254 / 0.6);
  }
  .footer-label {
    font-family: var(--mk-font-mono, ui-monospace, monospace);
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: 0;
    color: rgb(254 254 254 / 0.55);
  }
  .footer-link {
    font-size: 0.9375rem;
    color: #fefefe;
    transition: opacity 0.15s;
  }
  .footer-link:hover {
    opacity: 0.7;
  }
  .footer-bar {
    font-family: var(--mk-font-mono, ui-monospace, monospace);
    font-size: 0.8125rem;
    background: color-mix(in srgb, #000 35%, var(--mk-band, #141414));
  }
  .footer-window {
    display: block;
    padding: 0.3rem 0.55rem;
    white-space: nowrap;
    color: rgb(254 254 254 / 0.75);
  }
  .footer-window:hover {
    color: #fefefe;
  }
  .footer-window.is-on {
    color: #141414;
    background: #e0e0e0;
  }
</style>

<style>
  [data-status-dot] .status-core,
  [data-status-dot] .status-ping {
    background-color: rgb(254 254 254 / 0.45);
  }
  [data-status-dot][data-state="unknown"] .status-ping {
    display: none;
  }
  [data-status-dot][data-state="ok"] :is(.status-core, .status-ping) {
    background-color: var(--color-emerald-500);
  }
  [data-status-dot][data-state="degraded"] :is(.status-core, .status-ping) {
    background-color: var(--color-amber-500);
  }
  [data-status-dot][data-state="down"] :is(.status-core, .status-ping) {
    background-color: var(--color-red-500);
  }
</style>

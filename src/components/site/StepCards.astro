---
/** Numbered step cards with a sample line of output under each. */
interface Props {
  steps: { title: string; text: string; code: string }[];
}
const { steps } = Astro.props;
---

<ol class="grid gap-4 sm:gap-6 lg:grid-cols-3">
  {
    steps.map((s, i) => (
      <li class="bg-surface flex min-w-0 flex-col rounded-2xl p-6 sm:p-8">
        <span class="eyebrow">Step {i + 1}</span>
        <p class="mt-3 text-lg font-medium tracking-tight text-balance">{s.title}</p>
        <p class="text-muted-foreground mt-2.5 flex-1 text-base leading-6 tracking-tight text-pretty">{s.text}</p>
        <code class="bg-card text-muted-foreground mt-6 block truncate rounded-md px-3 py-2 font-mono text-xs">{s.code}</code>
      </li>
    ))
  }
</ol>

---
/** A screenshot with numbered pins (x, y in % of the image). The page lists what each number means, with `PinLegend`. */
export type Pin = { x: number; y: number; title: string; text: string };

interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  pins: Pin[];
}
const { src, alt, width, height, pins } = Astro.props;
---

<figure class="annotated">
  <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
  {
    pins.map((p, i) => (
      <span class="pin" style={`left:${p.x}%;top:${p.y}%`} aria-hidden="true">
        {i + 1}
      </span>
    ))
  }
</figure>

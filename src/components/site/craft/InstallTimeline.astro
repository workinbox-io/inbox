---
/** Steps on one line with numbered nodes (vertical on narrow screens). The slot `step-<index>` holds each step's sample. */
interface Props {
  steps: { title: string; text: string }[];
}
const { steps } = Astro.props;
const bodies = await Promise.all(steps.map((_, i) => (Astro.slots.has(`step-${i}`) ? Astro.slots.render(`step-${i}`) : null)));
---

<ol class="timeline">
  {
    steps.map((s, i) => (
      <li class="timeline-step">
        <span class="timeline-node">{String(i + 1).padStart(2, "0")}</span>
        <h3 set:html={s.title} />
        <p>{s.text}</p>
        {bodies[i] ? <div class="timeline-body" set:html={bodies[i]} /> : null}
      </li>
    ))
  }
</ol>

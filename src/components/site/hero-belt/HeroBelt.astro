---
/**
 * The home hero's strip: boxes (the app icon) riding a conveyor belt, and the workspace's things dropping into them
 * from the middle: mail, a message, a note, an event, a file, a contact. CSS only.
 *
 * Timing: every box moves one spacing (--s) per period (--t), so a box is under the chute at every multiple of --t.
 * The row is anchored on the middle, so that holds at any width. Each of the six items falls on a 6×--t cycle,
 * offset by one period, and lands at the end of its period. With reduced motion everything stands still: a box under
 * the chute and a mail above it.
 */
import { ICONS, type IconName } from "./icons";

const BOXES = 21; // enough for a 2560px screen at --s = 12rem
const ITEMS: IconName[] = ["mail", "chat", "note", "calendar", "file", "contact"];
const ROLLERS = 48;
const svg = (name: IconName) => `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">${ICONS[name]}</svg>`;
---

<div class="belt" aria-hidden="true">
  <div class="belt-items">
    {ITEMS.map((name, i) => <span class="belt-item" style={`--k: ${i}`} set:html={svg(name)} />)}
  </div>
  <div class="belt-row" style={`--n: ${BOXES}`}>
    {Array.from({ length: BOXES }, () => <span class="belt-box" set:html={svg("box")} />)}
  </div>
  <div class="belt-track"></div>
  <div class="belt-rollers">
    {Array.from({ length: ROLLERS }, () => <span class="belt-roller" />)}
  </div>
</div>

<style>
  .belt {
    --s: 12rem; /* spacing between boxes; the tread's pattern (2rem) divides it */
    --t: 3s; /* one box per period */
    --box: 4.5rem;
    --item: 2.25rem;
    --track: 9.5rem; /* from the top of the strip to the belt */
    position: relative;
    height: calc(var(--track) + 2.25rem);
    overflow: hidden;
    color: #fff;
  }
  .belt svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* The boxes: a row centred on the middle, sliding one spacing per period. */
  .belt-row {
    position: absolute;
    top: calc(var(--track) - var(--box) + 0.35rem);
    left: calc(50% - (var(--n) - 1) / 2 * var(--s) - var(--box) / 2);
    display: flex;
    gap: calc(var(--s) - var(--box));
    animation: belt-ride var(--t) linear infinite;
  }
  .belt-box {
    width: var(--box);
    height: var(--box);
    flex: none;
  }
  @keyframes belt-ride {
    from {
      transform: translateX(calc(-1 * var(--s)));
    }
    to {
      transform: translateX(0);
    }
  }

  /* The belt: a line whose tread moves at the boxes' speed, rollers turning under it. */
  .belt-track {
    position: absolute;
    inset-inline: 0;
    top: calc(var(--track) + 0.35rem);
    height: 0.25rem;
    background: repeating-linear-gradient(90deg, rgb(255 255 255 / 0.4) 0 1rem, rgb(255 255 255 / 0.14) 1rem 2rem);
    animation: belt-tread var(--t) linear infinite;
  }
  @keyframes belt-tread {
    to {
      background-position-x: var(--s);
    }
  }
  .belt-rollers {
    position: absolute;
    top: calc(var(--track) + 0.6rem);
    left: 50%;
    display: flex;
    gap: 3rem;
    padding-block: 0.25rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.14);
    translate: -50% 0;
  }
  .belt-roller {
    flex: none;
    width: 0.875rem;
    height: 0.875rem;
    border: 1.5px solid rgb(255 255 255 / 0.22);
    border-radius: 999px;
    background: linear-gradient(rgb(255 255 255 / 0.22), rgb(255 255 255 / 0.22)) center / 1.5px 100% no-repeat;
    animation: belt-roll calc(var(--t) / 4) linear infinite;
  }
  @keyframes belt-roll {
    to {
      rotate: 1turn;
    }
  }

  /* The items: one falls per period, into the box arriving under the middle. */
  .belt-items {
    position: absolute;
    top: 0;
    left: 50%;
    width: var(--item);
    height: calc(var(--track) - var(--box) * 0.55);
    translate: -50% 0;
  }
  .belt-item {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--item);
    height: var(--item);
    opacity: 0;
    animation: belt-drop calc(var(--t) * 6) infinite;
    animation-delay: calc(var(--k) * var(--t) - var(--t) * 6);
  }
  /* 16.67% is one period: wait at the top, fall faster and faster, land as the box arrives, vanish into it. */
  @keyframes belt-drop {
    0% {
      opacity: 0;
      transform: translateY(-0.5rem) rotate(-8deg);
    }
    5% {
      opacity: 1;
      transform: translateY(0) rotate(-8deg);
      animation-timing-function: cubic-bezier(0.55, 0, 1, 0.45);
    }
    16.2% {
      opacity: 1;
      transform: translateY(calc(var(--track) - var(--box) * 0.55 - var(--item))) rotate(6deg) scale(1);
    }
    17.5% {
      opacity: 0;
      transform: translateY(calc(var(--track) - var(--box) * 0.55 - var(--item) * 0.6)) rotate(6deg) scale(0.6);
    }
    100% {
      opacity: 0;
    }
  }

  @media (max-width: 640px) {
    .belt {
      --box: 3.75rem;
      --item: 2rem;
      --track: 8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .belt-row,
    .belt-track,
    .belt-roller,
    .belt-item {
      animation: none;
    }
    .belt-row {
      transform: none;
    }
    .belt-item:first-child {
      opacity: 1;
      transform: translateY(calc((var(--track) - var(--box)) * 0.35));
    }
  }
</style>

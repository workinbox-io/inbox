---
/**
 * "A day at Acme Studio": six moments from 9:00 to 17:00 on a time line, each a small faux screen of the real app (drawn
 * here, scoped by `.appmini`), then the real demo form. The story comes straight from the demo's seed (content.ts, or
 * content-pl.ts on /pl) so the visitor finds the same mail, note, chat and records after "Try the demo".
 */
import { Calendar, CheckSquare, Folder, Mail, MessageSquare, Package, Paperclip, PenLine } from "lucide-react";
import Block from "./Block.astro";
import DemoForm from "./DemoForm.astro";
import * as en from "@/lib/server/demo/content";
import * as pl from "@/lib/server/demo/content-pl";
import { siteLocale, tFor } from "@/lib/i18n/site";

const locale = siteLocale(Astro.url);
const t = tFor(locale);
const s = locale === "pl" ? pl : en;
const person = (k: keyof typeof s.PEOPLE) => s.PEOPLE[k].name;
const first = (name: string) => name.split(" ")[0]!;
const [contract, oliver] = s.MAIL;
const [, decisions, todo] = s.NOTES[0]!.markdown.split("\n## ");
const bullets = (block: string | undefined) => (block ?? "").split("\n").filter((l) => l.startsWith("- "));
const notes = [...bullets(decisions).slice(0, 2).map((l) => ({ text: l.slice(2), open: false })), ...bullets(todo).filter((l) => l.startsWith("- [ ] ")).slice(0, 1).map((l) => ({ text: l.slice(6), open: true }))];
const kickoff = s.EVENTS[2]!;
const clock = (h: number) => `${Math.floor(h)}:${h % 1 ? "30" : "00"}`;
const copyTask = s.TASK_ROWS.find((r) => r[0] === s.COPY_TASK)!;
const heroTask = s.TASK_ROWS.find((r) => r[2] === "diana" && r[1] === s.TASK_ROWS[4]![1])!;
const deal = s.DEAL_ROWS[0]!;
const gear = [s.RENTAL_ROWS[0]!, s.RENTAL_ROWS[4]!, s.RENTAL_ROWS[1]!, s.RENTAL_ROWS[3]!];
const gearTone = ["violet", "violet", "amber", "green"] as const;
const draftBody = s.DRAFTS.support.text.split("\n\n").slice(0, 2);
const mention = `@${person("anna")}`;

const avatar = ["bg-[#f97316]", "bg-[#334155]", "bg-[#dc2626]", "bg-[#0d9488]", "bg-[#7c3aed]"];
const tone = {
  green: "bg-[#e3f5ec] text-[#1b7a4b]",
  amber: "bg-[#fdf0d8] text-[#9a5b0b]",
  violet: "bg-[#ece8fb] text-[#5b44c4]",
  blue: "bg-[#e5edff] text-[#2f5bff]",
  gray: "bg-black/[0.06] text-[#555]",
};
const days = [
  {
    time: "9:00", icon: Mail, title: t("The signed contract arrives"),
    text: t("Marta sends it, labelled Brightloop with the PDF attached. An AI app has already left a reply in your Drafts."),
  },
  { time: "9:40", icon: Mail, title: t("A colleague's draft, yours to take over"), text: t("Diana started answering Oliver in support@. You see “Draft by Diana Nowak” and take it over.") },
  { time: "11:00", icon: Calendar, title: t("The kickoff and its note"), text: t("The meeting note is linked to the event and open to everyone who was invited.") },
  { time: "13:30", icon: MessageSquare, title: t("Chat that points at the work"), text: t("Mention a file, a note or a person with @. The people it concerns get it in their bell.") },
  { time: "15:00", icon: CheckSquare, title: t("Tasks and the deal move along"), text: t("Diana's comment waits in the task. The spring campaign deal is marked Won.") },
  { time: "17:00", icon: Package, title: t("Gear for the shoot is reserved"), text: t("The camera kit and the LED panels are booked for the Brightloop shoot, back in four days.") },
];
const chip = "inline-flex items-center gap-1 rounded-md bg-black/[0.05] px-1.5 py-px font-medium text-[#222]";
const bar = "flex items-center gap-2 border-b border-black/[0.07] px-3 py-2 font-semibold";
const badge = "rounded-full px-2 py-px text-[0.92em] font-medium whitespace-nowrap";
---

<Block id="day" label={t("Try it")}>
  <Fragment slot="title">{t("A day at")}{" "}<em>{s.ORG_NAME}</em></Fragment>
  <Fragment slot="text">{t("Anna is an account manager. Marta from Brightloop has just signed the spring campaign. Here is her day in Work Inbox. The same workspace is waiting in the demo, ready to click through.")}</Fragment>
  <ol class="grid mt-12 gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
    {
      days.map((d, i) => (
        <li class="relative min-w-0 pt-5 border-t border-foreground">
          <span class="absolute -top-[5px] left-0 size-[9px] bg-primary" aria-hidden="true"></span>
          <span class="block text-3xl font-semibold tracking-tight">{d.time}</span>
          <div class="appmini mt-4 h-64 overflow-hidden rounded-xl border border-black/10 bg-white text-left text-[12px] leading-snug text-[#1a1a1a] shadow-[0_12px_30px_-18px_rgba(20,20,60,0.25)]" aria-hidden="true">
            {i === 0 && (
              <>
                <p class={bar}><Mail className="size-3.5" />{t("Inbox")}<span class="ml-auto text-[0.92em] font-normal text-[#777]">{person("anna")}</span></p>
                <div class="relative px-3 py-2 border-l-2 border-[#2f9e8f]">
                  <div class="flex items-center gap-2"><i class={`grid size-5 shrink-0 place-items-center rounded-full text-[9px] not-italic font-semibold text-white ${avatar[0]}`}>M</i><b class="truncate">{contract!.fromName}</b><span class="ml-auto text-[#777]">9:00</span></div>
                  <div class="flex items-center gap-1.5 mt-1"><span class="truncate">{contract!.subject}</span><span class={`${badge} bg-black/[0.06]`}>{contract!.label}</span></div>
                  <span class={`${chip} mt-1.5`}><Paperclip className="size-3 text-[#777]" />{s.CONTRACT_FILE}</span>
                </div>
                <div class="px-3 py-2 border-t border-black/[0.06]"><div class="flex items-center gap-2"><i class={`grid size-5 shrink-0 place-items-center rounded-full text-[9px] not-italic font-semibold text-white ${avatar[1]}`}>O</i><b class="truncate">{oliver!.fromName}</b><span class="ml-auto text-[#777]">8:45</span></div><div class="mt-1 truncate text-[#555]">{oliver!.subject}</div></div>
                <div class="m-3 rounded-lg bg-[#f6f6f6] p-2.5"><p class="flex items-center gap-1.5 text-[0.92em] text-[#777]"><PenLine className="size-3" />{t("Draft left by your AI app")}</p><p class="flex items-center gap-2 mt-1"><span class="font-medium truncate">{s.DRAFTS.ai.subject}</span><span class="px-2.5 py-0.5 ml-auto text-white rounded-full bg-[#1a1a1a] font-medium">{t("Send")}</span></p></div>
              </>
            )}
            {i === 1 && (
              <>
                <p class={bar}><Mail className="size-3.5" />support@<span class={`${badge} ml-auto bg-[#ece8fb] text-[#5b44c4]`}>{t("Shared mailbox")}</span></p>
                <div class="px-3 py-2 border-b border-black/[0.06]"><p class="font-semibold">{s.DRAFTS.support.thread}</p><p class="mt-0.5 text-[#777]">{oliver!.fromName} · 8:45</p></div>
                <div class="m-3 rounded-lg border border-dashed border-black/20 p-2.5">
                  <p class="flex items-center gap-1.5 font-medium text-[#555]"><PenLine className="size-3" />{t("Draft by {name}", { name: person("diana") })}</p>
                  <p class="mt-1.5 text-[#444] line-clamp-4">{draftBody.join(" ")}</p>
                  <p class="flex gap-2 mt-2"><span class="px-2.5 py-0.5 text-white rounded-full bg-[#1a1a1a] font-medium">{t("Take over")}</span><span class="px-2.5 py-0.5 rounded-full border border-black/15 font-medium">{t("Leave it")}</span></p>
                </div>
              </>
            )}
            {i === 2 && (
              <>
                <p class={bar}><Calendar className="size-3.5" />{t("Calendar")}<span class="ml-auto font-normal text-[#777]">{t("Wed")}</span></p>
                <div class="flex gap-2.5 px-3 py-2.5">
                  <span class="w-1 rounded-full bg-[#2f9e8f]"></span>
                  <div class="min-w-0"><p class="font-semibold truncate">{kickoff.title}</p><p class="mt-0.5 text-[#777]">{clock(kickoff.from)} – {clock(kickoff.to)} · {kickoff.location}</p>
                    <p class="flex mt-1.5">{(["anna", "diana", "tomasz"] as const).map((k, j) => <i class={`-ml-1 first:ml-0 grid size-5 place-items-center rounded-full border-2 border-white text-[9px] not-italic font-semibold text-white ${avatar[[0, 1, 2][j]!]}`}>{person(k)[0]}</i>)}</p></div>
                </div>
                <div class="mx-3 rounded-lg bg-[#f6f6f6] p-2.5">
                  <p class="flex items-center gap-1.5 font-semibold"><PenLine className="size-3 text-[#777]" />{s.NOTES[0]!.title}<span class={`${badge} ml-auto ${tone.blue}`}>{t("Meeting note")}</span></p>
                  <ul class="mt-1.5 space-y-1">{notes.map((n) => <li class="flex gap-1.5"><span class:list={["mt-[3px] size-3 shrink-0 rounded-[3px] border", n.open ? "border-black/30" : "border-transparent bg-[#2f5bff]"]}></span><span class="truncate">{n.text}</span></li>)}</ul>
                </div>
              </>
            )}
            {i === 3 && (
              <>
                <p class={bar}><span class="text-[#777]">#</span>{s.CHANNEL}<span class="ml-auto font-normal text-[#777]">3</span></p>
                <div class="px-3 py-2 space-y-2.5">
                  <div class="flex gap-2"><i class={`grid size-6 shrink-0 place-items-center rounded-full text-[10px] not-italic font-semibold text-white ${avatar[1]}`}>D</i><p class="min-w-0"><b>{person("diana")}</b> <span class="text-[#777]">13:12</span><br />{s.CHAT.brief.split("{file}")[0]}<span class={chip}><Folder className="size-3 text-[#dc2626]" />{s.BRIEF_FILE}</span></p></div>
                  <div class="flex gap-2"><i class={`grid size-6 shrink-0 place-items-center rounded-full text-[10px] not-italic font-semibold text-white ${avatar[2]}`}>T</i><p class="min-w-0"><b>{person("tomasz")}</b> <span class="text-[#777]">13:28</span><br /><span class="rounded bg-[#fdf0d8] px-1 text-[#8a4b00]">{mention}</span> {s.CHAT.approver.replace("@anna", "").trim()}</p></div>
                </div>
                <p class="absolute inset-x-3 bottom-3 px-3 py-2 rounded-lg border border-black/10 text-[#999]">{t("Reply to the thread, @ for people, files, notes")}</p>
              </>
            )}
            {i === 4 && (
              <>
                <p class={bar}><CheckSquare className="size-3.5" />{s.TASKS}<span class="font-normal text-[#777]">· {s.DEALS}</span></p>
                <div class="px-3 py-2 border-b border-black/[0.06]">
                  <p class="flex items-center gap-2"><b class="truncate">{copyTask[0]}</b><span class={`${badge} ml-auto ${tone.amber}`}>{copyTask[1]}</span></p>
                  <p class="flex gap-1.5 mt-1.5 text-[#555]"><i class={`grid size-4 shrink-0 place-items-center rounded-full text-[8px] not-italic font-semibold text-white ${avatar[1]}`}>D</i><span><b>{first(person("diana"))}:</b> <span class="rounded bg-[#fdf0d8] px-1 text-[#8a4b00]">{mention}</span> {s.TASK_COMMENTS[0]![1].replace("@anna", "").trim()}</span></p>
                </div>
                <p class="flex items-center gap-2 px-3 py-2 border-b border-black/[0.06]"><span class="truncate">{heroTask[0]}</span><span class={`${badge} ml-auto ${tone.blue}`}>{heroTask[1]}</span></p>
                <p class="flex items-center gap-2 px-3 py-2.5"><span class="min-w-0"><b class="block truncate">{deal[0]}</b><span class="text-[#777]">{deal[2]}</span></span><span class="ml-auto text-right"><b class="block">{(deal[3]).toLocaleString(locale === "pl" ? "pl-PL" : "en-US")} EUR</b><span class={`${badge} ${tone.green}`}>{deal[1]}</span></span></p>
              </>
            )}
            {i === 5 && (
              <>
                <p class={bar}><Package className="size-3.5" />{s.RENTALS}</p>
                {gear.map((g, j) => (
                  <p class="flex items-center gap-2 px-3 py-2 border-b border-black/[0.06] last:border-0">
                    <span class="min-w-0"><b class="block truncate">{g[0]}</b>{g[4] && <span class="block truncate text-[#777]">{g[4]}{g[5] ? ` · ${t("back in {n} days", { n: g[5] })}` : ""}</span>}</span>
                    <span class={`${badge} ml-auto ${tone[gearTone[j]!]}`}>{g[1]}</span>
                  </p>
                ))}
              </>
            )}
          </div>
          <h3 class="mt-4 text-lg font-semibold tracking-tight">{d.title}</h3>
          <p class="mt-1 text-muted-foreground text-pretty">{d.text}</p>
        </li>
      ))
    }
  </ol>
  <div class="flex flex-wrap items-center mt-14 gap-x-6 gap-y-3">
    <DemoForm size="lg" variant="default" />
    <p class="text-sm text-muted-foreground">{t("No signup, no card. Mail is never sent out of the demo. The workspace is deleted after 24 hours.")}</p>
  </div>
</Block>

<style>
  /* The app's look stays inside the mini screens: its own radius and a system UI face, nothing inherited from Navy. */
  .appmini { font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif; position: relative; letter-spacing: 0; }
  .appmini :global(*) { font-style: normal; }
</style>

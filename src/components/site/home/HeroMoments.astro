---
/**
 * Three small cards that pop up in turn around the hero's browser window, each a strength of the suite: a file mentioned
 * in chat, a colleague's draft to take over in a shared mailbox, a meeting with its note. Story from the demo's seed, like
 * Day. Large screens only; with reduced motion they all sit still.
 */
import { CalendarDays, FileText, Mail, MessagesSquare, PenLine } from "lucide-react";
import * as en from "@/lib/server/demo/content";
import * as pl from "@/lib/server/demo/content-pl";
import { siteLocale, tFor } from "@/lib/i18n/site";

const locale = siteLocale(Astro.url);
const t = tFor(locale);
const s = locale === "pl" ? pl : en;
const person = (k: keyof typeof s.PEOPLE) => s.PEOPLE[k].name;
const kickoff = s.EVENTS[2]!;
const clock = (h: number) => `${Math.floor(h)}:${h % 1 ? "30" : "00"}`;
const card = "hm absolute hidden w-72 rounded-xl bg-white p-3.5 text-left text-[13px] leading-snug text-[#222] shadow-[0_20px_50px_-12px_rgba(20,25,80,0.45)] ring-1 ring-black/5 lg:block";
const eyebrow = "mb-2 flex items-center gap-1.5 text-[11px] font-medium uppercase tracking-wide text-[#777]";
const avatar = "grid size-6 shrink-0 place-items-center rounded-full text-[10px] font-semibold text-white";
---

<div aria-hidden="true">
  <div class:list={[card, "-left-10 top-[22%]"]} style="--d:0s">
    <p class={eyebrow}><MessagesSquare className="size-3.5" />{t("Chat")}</p>
    <div class="flex gap-2">
      <i class:list={[avatar, "not-italic bg-[#334155]"]}>{person("diana")[0]}</i>
      <p class="min-w-0"><b>{person("diana")}</b><br />{s.CHAT.brief.split("{file}")[0]}<span class="inline-flex items-center gap-1 rounded-md bg-black/[0.05] px-1.5 py-px font-medium"><FileText className="size-3 text-[#dc2626]" />{s.BRIEF_FILE}</span></p>
    </div>
  </div>
  <div class:list={[card, "-right-10 top-[12%]"]} style="--d:4s">
    <p class={eyebrow}><Mail className="size-3.5" />support@</p>
    <p class="font-semibold truncate">{s.DRAFTS.support.thread}</p>
    <p class="mt-1 flex items-center gap-1.5 text-[#9a5b0b]"><PenLine className="size-3.5" />{t("Draft by {name}", { name: person("diana") })}</p>
    <span class="mt-2.5 inline-block rounded-md bg-[#2f5bff] px-2.5 py-1 text-xs font-medium text-white">{t("Take over")}</span>
  </div>
  <div class:list={[card, "-right-6 bottom-[10%]"]} style="--d:8s">
    <p class={eyebrow}><CalendarDays className="size-3.5" />{t("Calendar")}</p>
    <p class="font-semibold">{kickoff.title}</p>
    <p class="mt-0.5 text-[#777]">{clock(kickoff.from)} – {clock(kickoff.to)} · {kickoff.location}</p>
    <p class="mt-2 inline-flex items-center gap-1.5 rounded-full bg-[#e5edff] px-2 py-0.5 text-xs font-medium text-[#2f5bff]"><PenLine className="size-3" />{t("Meeting note")}</p>
  </div>
</div>

<style>
  /* 12 s loop, each card on stage for about 3.5 s of its 4 s slot. */
  .hm {
    opacity: 0;
    animation: hm 12s var(--d) infinite both;
  }
  @keyframes hm {
    0% { opacity: 0; transform: translateY(12px) scale(0.96); }
    4%, 28% { opacity: 1; transform: none; }
    33%, 100% { opacity: 0; transform: translateY(-6px) scale(0.98); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hm { animation: none; opacity: 1; }
  }
</style>

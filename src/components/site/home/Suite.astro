---
/** The suite (App switcher): a rail of the apps, the a faux screen of the chosen one and the product it replaces, with its logo. */
import { AtSign, Command, Paperclip } from "lucide-react";
import Block from "./Block.astro";
import DemoForm from "./DemoForm.astro";
import Faux from "./Faux.astro";
import { APPS } from "@/config/apps";
import { lp, siteLocale, tFor } from "@/lib/i18n/site";

const locale = siteLocale(Astro.url);
const t = tFor(locale);
/** What each app replaces, by app slug; logos in public/logos/brands (Simple Icons, CC0; Google Contacts from Wikimedia Commons). */
const replaces: Record<string, { name: string; logo: string }> = {
  "custom-domain-email": { name: "Gmail", logo: "gmail" },
  "team-chat": { name: "Slack", logo: "slack" },
  "shared-notes": { name: "Notion", logo: "notion" },
  "team-calendar": { name: "Google Calendar", logo: "googlecalendar" },
  "shared-drive": { name: "Google Drive", logo: "googledrive" },
  "shared-contacts": { name: "Google Contacts", logo: "googlecontacts" },
  "custom-apps": { name: "Airtable", logo: "airtable" },
};
const apps = APPS.map((a) => ({ ...a, label: t(a.label), description: t(a.description), href: lp(locale, `/${a.slug}`), replaces: replaces[a.slug]! }));
const perks = [
  { icon: AtSign, title: t("@ anything:"), text: t("people, files, notes, events, contacts, mail threads, in chat and mail.") },
  { icon: Command, title: t("One ⌘K:"), text: t("jump, search and act in every app.") },
  { icon: Paperclip, title: t("Drive in mail:"), text: t("attach a file, or save an attachment to Drive.") },
];
---

<Block id="features" label={t("One workspace")}>
  <Fragment slot="title">{t("Six apps that")}{" "}<em>{t("know about each other.")}</em></Fragment>
  <Fragment slot="text">{t("Mail, chat, notes, calendar, drive, contacts and your own lists. Mention anything with @, search everything with ⌘K, attach files without leaving the message.")}</Fragment>
  <div data-suite class="grid grid-cols-1 mt-10 *:min-w-0 gap-6 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-3">
      <div role="tablist" aria-label={t("Apps")} aria-orientation="vertical" class="flex flex-wrap gap-2 lg:flex-col">
        {
          apps.map((a, i) => (
            <button type="button" role="tab" id={`suite-tab-${a.slug}`} aria-controls={`suite-panel-${a.slug}`} aria-selected={String(i === 0)} tabindex={i === 0 ? 0 : -1} data-tab={a.slug} class="flex items-center text-left transition-colors border gap-2.5 px-3 py-2.5 lg:gap-3 lg:px-4 lg:py-3 border-border bg-background hover:bg-muted aria-selected:border-inverse aria-selected:bg-inverse aria-selected:text-inverse-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring">
              <a.icon className="size-5 shrink-0" aria-hidden="true" />
              <span class="min-w-0">
                <span class="block text-sm font-medium">{a.label}</span>
                <span class="items-center hidden mt-0.5 text-xs gap-1.5 lg:flex opacity-80">
                  <span class="grid bg-white rounded-sm place-items-center size-4.5 shrink-0 ring-1 ring-border"><img src={`/logos/brands/${a.replaces.logo}.svg`} alt="" width="12" height="12" class="size-3" /></span>
                  {t("Replaces {name}", { name: a.replaces.name })}
                </span>
              </span>
            </button>
          ))
        }
      </div>
    </div>
    <div class="lg:col-span-9">
      {
        apps.map((a, i) => (
          <div role="tabpanel" id={`suite-panel-${a.slug}`} aria-labelledby={`suite-tab-${a.slug}`} data-panel={a.slug} hidden={i !== 0}>
            <div class="flex flex-wrap items-center justify-between mb-4 gap-x-6 gap-y-2">
              <p class="text-lg"><b class="font-semibold">{a.label}</b>{" "}<span class="text-muted-foreground">{a.description}</span></p>
              <p class="flex items-center text-sm gap-2 text-foreground">
                <img src={`/logos/brands/${a.replaces.logo}.svg`} alt="" width="20" height="20" class="size-5" />
                {t("Replaces {name}", { name: a.replaces.name })}
              </p>
            </div>
            <Faux app={a.slug} />
            <div class="flex flex-wrap items-center mt-6 gap-x-6 gap-y-3">
              <DemoForm label={t("Try it in the demo")} variant="accent" />
              <a href={a.href} class="inline-flex items-center text-sm underline min-h-11 underline-offset-4 hover:text-muted-foreground">{t("Read about this app")}</a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
  <ul role="list" class="grid mt-12 text-sm border-t border-l sm:grid-cols-3 border-border">
    {
      perks.map((p) => (
        <li class="flex gap-3 p-5 border-b border-r border-border">
          <p.icon className="mt-0.5 size-5 shrink-0 text-primary" aria-hidden="true" />
          <p><b class="font-semibold">{p.title}</b>{" "}<span class="text-muted-foreground">{p.text}</span></p>
        </li>
      ))
    }
  </ul>
</Block>

<script>
  // Tabs: click, arrows, Home and End.
  const root = document.querySelector<HTMLElement>("[data-suite]");
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-tab]")];
    const select = (tab: HTMLButtonElement) => {
      for (const b of tabs) {
        const on = b === tab;
        b.setAttribute("aria-selected", String(on));
        b.tabIndex = on ? 0 : -1;
        root.querySelector<HTMLElement>(`[data-panel="${b.dataset.tab}"]`)!.hidden = !on;
      }
    };
    tabs.forEach((b, n) => {
      b.addEventListener("click", () => select(b));
      b.addEventListener("keydown", (e) => {
        const next = e.key === "Home" ? 0 : e.key === "End" ? tabs.length - 1 : ["ArrowRight", "ArrowDown"].includes(e.key) ? (n + 1) % tabs.length : ["ArrowLeft", "ArrowUp"].includes(e.key) ? (n + tabs.length - 1) % tabs.length : -1;
        if (next < 0) return;
        e.preventDefault();
        select(tabs[next]!);
        tabs[next]!.focus();
      });
    });
  }
</script>

---
/**
 * A pixel icon drawn as SVG squares at build time (no script). Without `colors` it is in the text colour (`2` and `3`
 * are lighter tones); with `colors`, each key maps to its own fill (the logo).
 */

interface Props {
  rows: string[];
  class?: string;
  colors?: Record<string, string>;
}
const { rows, class: className = "size-16", colors } = Astro.props;
const opacity: Record<string, number> = { "5": 1, "4": 0.8, "3": 0.55, "2": 0.3 };
const w = Math.max(...rows.map((r) => r.length));
const cells = rows.flatMap((row, y) => [...row].flatMap((c, x) => (c !== "." && (!colors || colors[c]) ? [{ x, y, c }] : [])));
---

<svg viewBox={`0 0 ${w} ${rows.length}`} shape-rendering="crispEdges" fill="currentColor" aria-hidden="true" class:list={[className]}>
  {cells.map((c) => (colors ? <rect x={c.x} y={c.y} width="1" height="1" fill={colors[c.c]} /> : <rect x={c.x} y={c.y} width="1" height="1" fill-opacity={opacity[c.c] ?? 1} />))}
</svg>

---
/** One layout of a scene as an SVG: edges, nodes, labels on the edges and the numbered markers shown with reduced motion. */
import Tile from "./Tile.astro"
import Chat from "./Chat.astro"
import Card from "./Card.astro"
import Note from "./Note.astro"
import Pill from "./Pill.astro"
import { txt } from "./steps"
import type { LayoutName, Scene } from "./scene"

interface Props {
  scene: Scene
  layout: LayoutName
}
const { scene, layout } = Astro.props
const geo = scene.geo[layout]
const content = scene.content
const nodes = Object.values(geo.nodes).filter((n) => !n.hidden)
const edges = geo.edges.filter((e) => !e.hidden)
const solid = nodes.filter((n) => n.def.kind === "tile" || n.def.kind === "bucket")
const floating = nodes.filter((n) => n.def.kind !== "tile" && n.def.kind !== "bucket")
// A handle where an edge meets a tile, one per spot even when edges share it.
const handles = [
  ...new Map(
    edges.flatMap((e) =>
      ([e.from, e.to] as const)
        .map((id, i) => ({ node: geo.nodes[id], p: e.ends[i], edge: e.id, end: i }))
        .filter((h) => h.node.def.kind === "tile" || h.node.def.kind === "bucket")
        .map((h) => [`${h.p.x},${h.p.y}`, h] as const),
    ),
  ).values(),
]

// A card's dashed line to the node it belongs to: across the gap between them, through the middle of their overlap.
const linkOf = (r: { x: number; y: number; w: number; h: number }, to?: string) => {
  const t = to ? geo.nodes[to]?.rect : undefined
  if (!t) return undefined
  const yOv = [Math.max(r.y, t.y), Math.min(r.y + r.h, t.y + t.h)]
  const xOv = [Math.max(r.x, t.x), Math.min(r.x + r.w, t.x + t.w)]
  if (yOv[1] - yOv[0] >= 16) {
    const y = (yOv[0] + yOv[1]) / 2
    const [x0, x1] = t.x >= r.x + r.w ? [r.x + r.w, t.x] : [t.x + t.w, r.x]
    return `M${x0} ${y}H${x1}`
  }
  if (xOv[1] - xOv[0] >= 16) {
    const x = (xOv[0] + xOv[1]) / 2
    const [y0, y1] = t.y >= r.y + r.h ? [r.y + r.h, t.y] : [t.y + t.h, r.y]
    return `M${x} ${y0}V${y1}`
  }
  return undefined
}

// Numbered markers: one per captioned step, next to what the step is about.
const markers: { n: number; x: number; y: number }[] = []
let n = 0
for (const s of scene.steps) {
  if (!s.caption) continue
  n++
  const edge = "edge" in s ? edges.find((e) => e.id === s.edge) : undefined
  const node = "node" in s ? geo.nodes[s.node] : undefined
  if (edge?.label) {
    const l = edge.label
    markers.push(l.beside ? { n, x: l.cx + l.w / 2 + 16, y: l.cy } : l.vertical ? { n, x: l.cx - l.w / 2 - 16, y: l.cy } : { n, x: l.cx, y: l.cy + 30 })
  } else if (edge) {
    const t = edge.tip
    markers.push({ n, x: t.x - edge.dir.x * 40 + edge.dir.y * 16, y: t.y - edge.dir.y * 40 - edge.dir.x * 16 })
  } else if (node && !node.hidden) {
    const r = node.rect
    if (node.def.kind === "note") markers.push({ n, x: r.x + 22, y: r.y + r.h / 2 })
    else markers.push({ n, x: r.x + r.w / 2, y: r.y + r.h + 18 })
  }
}
---

<svg data-layout={layout} viewBox={`0 0 ${geo.w} ${geo.h}`} role="img" aria-hidden="true">
  {edges.map((e) => <path class="line" data-edge={e.id} data-from={e.from} data-to={e.to} data-shaft={e.shaft} d={e.shaft} />)}
  {
    solid.map((nd) => {
      const { x, y, w, h } = nd.rect
      const d = nd.def
      return (
        <Tile
          id={nd.id}
          x={x}
          y={y}
          w={w}
          h={h}
          label={d.label}
          sub={d.sub}
          icon={d.icon}
          logo={d.logo}
          paper={d.paper}
          rows={content.rows[nd.id]}
          check={content.confirm.has(nd.id)}
          layout={layout}
        />
      )
    })
  }
  {handles.map((h) => <circle class="sb-handle" data-edge={h.edge} data-end={h.end} cx={h.p.x} cy={h.p.y} r="4" />)}
  {edges.filter((e) => e.label).map((e) => <Pill cx={e.label!.cx} cy={e.label!.cy} text={e.label!.text} edge={e.id} />)}
  {
    floating.map((nd) => {
      const { x, y, w, h } = nd.rect
      const d = nd.def
      if (d.kind === "chat") return <Chat id={nd.id} x={x} y={y} w={w} clipId={`${scene.id}-${layout}-${nd.id}`} channel={d.channel} history={d.history} msg={content.chat[nd.id]} />
      if (d.kind === "card") return <Card id={nd.id} x={x} y={y} w={w} h={h} title={d.title} c={content.card[nd.id]} link={linkOf(nd.rect, d.attach)} layout={layout} />
      if (d.kind === "note") return <Note id={nd.id} x={x} y={y} w={w} h={h} text={txt(d.text, layout)} />
      return null
    })
  }
  {
    markers.map((m) => (
      <g class="num">
        <circle cx={m.x} cy={m.y} r="10" />
        <text x={m.x} y={m.y}>{m.n}</text>
      </g>
    ))
  }
</svg>

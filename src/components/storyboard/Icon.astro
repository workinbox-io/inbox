---
import { ICONS, type IconName } from "./icons";

interface Props {
  name: IconName;
  x: number;
  y: number;
  size?: number;
  class?: string;
}
const { name, x, y, size = 24, class: className = "ico" } = Astro.props;
---

<g transform={`translate(${x} ${y}) scale(${size / 24})`} class={className}>
  {ICONS[name].map((d) => <path d={d} />)}
</g>

---
/** A small badge sitting on a connection line. */
interface Props {
  cx: number
  cy: number
  text: string
  edge?: string
}
const { cx, cy, text, edge } = Astro.props
const w = Math.round(text.length * 7.3 + 20)
---

<g class="sb-pill" data-edge={edge}>
  <rect class="pill" x={cx - w / 2} y={cy - 12} width={w} height="24" rx="12"></rect>
  <text class="pill-t" x={cx} y={cy + 0.5} text-anchor="middle" dominant-baseline="central">{text}</text>
</g>

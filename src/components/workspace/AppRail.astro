---
/**
 * The members' app switcher (MailLayout has no dashboard sidebar): Mail, Notes and Contacts. Owners and admins switch
 * through the dashboard sidebar instead.
 */
import { t } from "@/lib/i18n/panel";
import { siteConfig } from "@/config/site";

interface Props {
  current: "mail" | "notes" | "contacts";
}
const { current } = Astro.props;
const apps = [
  {
    key: "mail",
    href: "/app/mail",
    label: t("Mail"),
    icon: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
  },
  {
    key: "notes",
    href: "/app/notes",
    label: t("Notes"),
    icon: '<path d="M13.4 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7.4"/><path d="M2 6h4"/><path d="M2 10h4"/><path d="M2 14h4"/><path d="M2 18h4"/><path d="M21.378 5.626a1 1 0 1 0-3.004-3.004l-5.01 5.012a2 2 0 0 0-.506.854l-.837 2.87a.5.5 0 0 0 .62.62l2.87-.837a2 2 0 0 0 .854-.506z"/>',
  },
  {
    key: "contacts",
    href: "/app/contacts",
    label: t("Contacts"),
    // lucide book-user
    icon: '<path d="M15 13a3 3 0 1 0-6 0"/><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20"/><circle cx="12" cy="8" r="2"/>',
  },
];
---

<nav aria-label={t("Applications")} class="hidden w-14 shrink-0 flex-col items-center gap-1 border-r py-3 sm:flex">
  <a href="/app/mail" aria-label={siteConfig.name} class="group relative mb-2 flex size-9 items-center justify-center">
    <img src="/logo.svg" alt="" width="32" height="32" class="size-8" />
    <span role="tooltip" class="bg-foreground text-background pointer-events-none absolute top-1/2 left-full z-50 ml-2 -translate-y-1/2 rounded-md px-3 py-1.5 text-xs whitespace-nowrap opacity-0 transition-opacity delay-0 group-hover:opacity-100 group-hover:delay-300 group-focus-visible:opacity-100">{siteConfig.name}</span>
  </a>
  {
    apps.map((app) => (
      <a
        href={app.href}
        aria-label={app.label}
        aria-current={current === app.key ? "page" : undefined}
        class="text-muted-foreground hover:bg-muted hover:text-foreground aria-[current=page]:bg-muted aria-[current=page]:text-foreground group relative flex size-9 items-center justify-center rounded-md"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={app.icon} />
        <span role="tooltip" class="bg-foreground text-background pointer-events-none absolute top-1/2 left-full z-50 ml-2 -translate-y-1/2 rounded-md px-3 py-1.5 text-xs whitespace-nowrap opacity-0 transition-opacity delay-0 group-hover:opacity-100 group-hover:delay-300 group-focus-visible:opacity-100">{app.label}</span>
        {app.key === "mail" && (
          <span data-mail-unread hidden class="bg-primary text-primary-foreground absolute -top-1 -right-1 min-w-4 rounded-full px-1 text-center text-[10px] leading-4 font-semibold tabular-nums" />
        )}
      </a>
    ))
  }
</nav>

<script>
  import { badgeText, watchUnread } from "@/lib/mail/unread-badge";

  const badge = document.querySelector<HTMLElement>("[data-mail-unread]");
  if (badge)
    watchUnread((n) => {
      badge.textContent = badgeText(n);
      badge.hidden = !n;
    });
</script>

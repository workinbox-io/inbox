---
/**
 * The members' app switcher (MailLayout has no dashboard sidebar): Mail, Notes and Contacts. Owners and admins switch
 * through the dashboard sidebar instead.
 */
import { t } from "@/lib/i18n/panel";
import { siteConfig } from "@/config/site";

interface Props {
  current: "mail" | "notes" | "contacts";
}
const { current } = Astro.props;
const apps = [
  {
    key: "mail",
    href: "/app/mail",
    label: t("Mail"),
    icon: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
  },
  {
    key: "notes",
    href: "/app/notes",
    label: t("Notes"),
    icon: '<path d="M13.4 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7.4"/><path d="M2 6h4"/><path d="M2 10h4"/><path d="M2 14h4"/><path d="M2 18h4"/><path d="M21.378 5.626a1 1 0 1 0-3.004-3.004l-5.01 5.012a2 2 0 0 0-.506.854l-.837 2.87a.5.5 0 0 0 .62.62l2.87-.837a2 2 0 0 0 .854-.506z"/>',
  },
  {
    key: "contacts",
    href: "/app/contacts",
    label: t("Contacts"),
    // lucide book-user
    icon: '<path d="M15 13a3 3 0 1 0-6 0"/><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20"/><circle cx="12" cy="8" r="2"/>',
  },
];
---

<nav aria-label={t("Applications")} class="hidden w-14 shrink-0 flex-col items-center gap-1 border-r py-3 sm:flex">
  <a href="/app/mail" aria-label={siteConfig.name} title={siteConfig.name} class="mb-2 flex size-9 items-center justify-center">
    <img src="/logo.svg" alt="" width="32" height="32" class="size-8" />
  </a>
  {
    apps.map((app) => (
      <a
        href={app.href}
        aria-label={app.label}
        title={app.label}
        aria-current={current === app.key ? "page" : undefined}
        class="text-muted-foreground hover:bg-muted hover:text-foreground aria-[current=page]:bg-muted aria-[current=page]:text-foreground flex size-9 items-center justify-center rounded-md"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={app.icon} />
      </a>
    ))
  }
</nav>

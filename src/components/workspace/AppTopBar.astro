---
/**
 * The user view's top bar (MailLayout): the app's name, ⌘K (apps and "new" actions; the app switcher on phones) and
 * the notifications. In the dashboard the same controls sit in AppLayout's header (slot "actions").
 */
import { NotificationCenter } from "@/components/mailbox/notification-center";
import { AppSearch } from "./app-search";

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<div class="bg-background grid shrink-0 grid-cols-[1fr_auto_1fr] items-center gap-2 border-b px-3 py-1">
  <span class="truncate text-sm font-medium">{title}</span>
  <AppSearch client:load />
  <div class="flex justify-end">
    <NotificationCenter client:load />
  </div>
</div>

---
import BaseLayout from "./BaseLayout.astro";
import { siteConfig } from "@/config/site";

interface Props {
  title: string;
  /** Sign-in and password pages: kept out of search results. */
  noindex?: boolean;
}
const { title, noindex = false } = Astro.props;
---

<BaseLayout title={title} lang={Astro.locals.locale} noindex={noindex}>
  <div class="flex min-h-svh flex-col items-center justify-center gap-6 p-4">
    <a href="/" class="flex items-center gap-2 text-base font-medium tracking-tight">
      <img src="/logo.svg" alt="" class="size-7" />{siteConfig.name}
    </a>
    <slot />
  </div>
</BaseLayout>

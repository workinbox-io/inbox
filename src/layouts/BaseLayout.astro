---
import "@/styles/global.css";
import "@/styles/brand.css";
import { siteConfig } from "@/config/site";
import { localeDir, type SiteLocale } from "@/lib/i18n/locales";
import { dictionaryVersion } from "@/lib/server/i18n";

interface Props {
  title: string;
  description?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Pages that must stay out of search engines and never leak their URL (share links). */
  noindex?: boolean;
  /** The dashboard and auth pages: the user's language (Astro.locals.locale), which also loads its words for the islands. */
  lang?: SiteLocale;
}

const { title, description = siteConfig.description, jsonLd, noindex = false, lang = "en" } = Astro.props;
// The dashboard's words in the user's language (lib/i18n/panel.ts), before any island runs.
const panelWords = lang !== "en" ? `/i18n/${lang}.js?v=${dictionaryVersion(lang)}` : null;
const fullTitle = `${title} · ${siteConfig.name}`;
// No trailing slash, to match the sitemap (prerendered pages see "/pricing/").
const canonical = Astro.site ? new URL(Astro.url.pathname.replace(/(.)\/$/, "$1"), Astro.site).href : undefined;
---

<!doctype html>
<html lang={lang} dir={localeDir(lang)}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      window.tapll = window.tapll || function () { (window.tapll.q = window.tapll.q || []).push(Array.from(arguments)); };
    </script>
    {Astro.locals.user && <meta name="tapll-user" content={Astro.locals.user.id} />}
    <script>
      let identified: string | null = null;
      function identify() {
        const id = document.querySelector<HTMLMetaElement>('meta[name="tapll-user"]')?.content;
        if (id && id !== identified) {
          window.tapll?.("identify", id);
          identified = id;
        }
      }
      identify();
      document.addEventListener("astro:page-load", identify);
      document.addEventListener("click", (event) => {
        if ((event.target as Element)?.closest('a[href="/api/auth/sign-out-redirect"]')) {
          window.tapll?.("reset");
          identified = null;
        }
      });
    </script>
    <script
      is:inline
      defer
      src="/_tapll/u.js"
      data-api="/_tapll"
      data-key="av_cbdcef797dab98b5e655e9ed8498d056ed0e91896d891325"
      data-mode="product_analytics"
      data-exclude="/invite/*,/mail/verify-forward"
      transition:persist="tapll"
    ></script>
    {panelWords && <script is:inline src={panelWords}></script>}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <script>
      import "@/lib/browser-theme";
    </script>
    {/* Kept across ClientRouter navigations (the dashboard), where a page may badge them. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" transition:persist="favicon-svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" transition:persist="favicon-ico" />
    <slot name="head" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {noindex && <meta name="referrer" content="no-referrer" />}
    {canonical && !noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL("/og.png", Astro.site ?? Astro.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {canonical && !noindex && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      // Apply the theme before paint to avoid a flash. "system" (nothing stored) follows the OS,
      // also when it changes while the page is open; "light" and "dark" are pinned.
      (() => {
        const mq = matchMedia("(prefers-color-scheme: dark)");
        const stored = () => {
          try {
            return localStorage.getItem("theme");
          } catch {
            return null;
          }
        };
        const apply = (root = document.documentElement) => {
          const t = stored();
          const mode = t === "light" || t === "dark" ? t : "system";
          root.dataset.themeMode = mode;
          root.classList.toggle("dark", mode === "dark" || (mode === "system" && mq.matches));
        };
        window.setThemeMode = (mode) => {
          try {
            if (mode === "system") localStorage.removeItem("theme");
            else localStorage.setItem("theme", mode);
          } catch {}
          apply();
        };
        window.nextThemeMode = () =>
          ({ system: "light", light: "dark", dark: "system" })[document.documentElement.dataset.themeMode] ?? "system";
        apply();
        mq.addEventListener("change", () => apply());
        // ClientRouter (the dashboard) copies the next page's <html> attributes over ours: theme the next
        // page before the swap, or it shows unthemed for a frame.
        document.addEventListener("astro:before-swap", (e) => apply(e.newDocument.documentElement));
      })();
    </script>
    {
      !noindex && (
        <script is:inline>
          // Our own cookieless page view count (lib/server/analytics.ts); nothing goes to third parties.
          (() => {
            if (navigator.webdriver || /^\/(app|api|invite)(\/|$)/.test(location.pathname)) return;
            try {
              navigator.sendBeacon("/api/collect", JSON.stringify({ u: location.href, r: document.referrer }));
            } catch {}
          })();
        </script>
      )
    }
  </head>
  <body class="bg-background text-foreground min-h-svh antialiased">
    <slot />
  </body>
</html>

---
import type { MarkdownHeading } from "astro";
import MarketingLayout from "./MarketingLayout.astro";
import DocsSidebar from "@/components/docs/DocsSidebar.astro";
import DocsToc from "@/components/docs/DocsToc.astro";
import DocsCta from "@/components/docs/DocsCta.astro";
import { siteConfig } from "@/config/site";
import { SECTIONS, docHref, getDocs, neighbours, type DocEntry } from "@/lib/docs";

interface Props {
  doc: DocEntry;
  headings: MarkdownHeading[];
}
const { doc, headings } = Astro.props;
const docs = await getDocs();
const { previous, next } = neighbours(docs, doc);
const updated = doc.data.updated.toISOString().slice(0, 10);
const url = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: doc.data.title,
    description: doc.data.description,
    url: url(docHref(doc)),
    dateModified: updated,
    inLanguage: "en",
    isPartOf: { "@type": "WebSite", name: siteConfig.name, url: url("/") },
    publisher: { "@type": "Organization", name: siteConfig.name, url: url("/"), logo: url("/logo.svg") },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Docs", item: url("/docs") },
      ...(doc.id === "index" ? [] : [{ "@type": "ListItem", position: 2, name: doc.data.title, item: url(docHref(doc)) }]),
    ],
  },
];

const arrowLeft = `<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7M19 12H5"/></svg>`;
const arrowRight = `<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>`;
const navBtn =
  "bg-secondary text-secondary-foreground hover:bg-secondary/80 inline-flex items-center justify-center gap-1.5 rounded-md text-sm font-medium transition-colors";
---

<MarketingLayout title={`${doc.data.title} · Docs`} description={doc.data.description} jsonLd={jsonLd} footer={false}>
  <div class="mx-auto flex w-full max-w-[1400px] flex-1 items-start px-2 lg:px-4">
    <DocsSidebar docs={docs} current={doc.id} />

    <div class="flex min-w-0 flex-1 items-stretch pb-8 text-[1.05rem] sm:text-[15px]">
      <div class="flex min-w-0 flex-1 flex-col">
        <div class="text-foreground mx-auto flex w-full max-w-160 min-w-0 flex-1 flex-col gap-6 px-4 py-6 md:px-0 lg:py-12">
          <!-- Mobile section picker -->
          <details class="bg-surface rounded-lg lg:hidden">
            <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-2.5 text-sm font-medium [&::-webkit-details-marker]:hidden">
              {doc.data.section} / {doc.data.title}
              <span class="text-muted-foreground text-xs">Menu</span>
            </summary>
            <div class="grid gap-3 px-4 pb-4">
              {
                SECTIONS.map((section) => (
                  <div>
                    <p class="text-muted-foreground mb-1 text-xs font-medium">{section}</p>
                    {docs
                      .filter((d) => d.data.section === section)
                      .map((d) => (
                        <a href={docHref(d)} class:list={["flex items-center gap-2 py-1 text-sm", d.id === doc.id ? "font-medium" : "text-muted-foreground"]}>
                          {d.data.title}
                        </a>
                      ))}
                  </div>
                ))
              }
            </div>
          </details>

          <div class="flex flex-col gap-2">
            <div class="flex items-center justify-between md:items-start">
              <h1 class="flex scroll-m-24 items-center gap-3 text-3xl font-medium tracking-tight">
                {doc.data.title}
              </h1>
              <div class="flex gap-2">
                {previous ? <a href={docHref(previous)} class={`${navBtn} size-8 md:size-7`} aria-label="Previous" set:html={arrowLeft} /> : null}
                {next ? <a href={docHref(next)} class={`${navBtn} size-8 md:size-7`} aria-label="Next" set:html={arrowRight} /> : null}
              </div>
            </div>
            <p class="text-muted-foreground text-[1.05rem] sm:text-base sm:text-balance md:max-w-[80%]">{doc.data.description}</p>
            <p class="text-muted-foreground text-xs">
              Updated <time datetime={updated}>{updated}</time> · <a href={`${docHref(doc)}.md`} class="hover:text-foreground underline underline-offset-4">Markdown</a>
            </p>
          </div>

          <article class="typeset w-full flex-1">
            <slot />
          </article>

          <div class="hidden h-16 w-full items-center gap-2 sm:flex">
            {
              previous ? (
                <a href={docHref(previous)} class={`${navBtn} h-8 px-3`}>
                  <Fragment set:html={arrowLeft} /> {previous.data.title}
                </a>
              ) : null
            }
            {
              next ? (
                <a href={docHref(next)} class={`${navBtn} ml-auto h-8 px-3`}>
                  {next.data.title} <Fragment set:html={arrowRight} />
                </a>
              ) : null
            }
          </div>
        </div>
      </div>

      <aside class="sticky top-[calc(var(--header-height)+1px)] hidden h-[90svh] w-72 shrink-0 flex-col gap-6 overflow-hidden pt-12 pb-8 xl:flex">
        <div class="scrollbar-none flex flex-col overflow-y-auto px-4">
          <DocsToc headings={headings} />
        </div>
        <div class="px-6">
          <DocsCta />
        </div>
      </aside>
    </div>
  </div>
</MarketingLayout>

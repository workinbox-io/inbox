---
import MarketingLayout from "./MarketingLayout.astro";
import { siteConfig } from "@/config/site";

interface Props {
  title: string;
  description: string;
  /** Overrides the shared legal date for pages updated on their own schedule. */
  updated?: string;
}
const { title, description, updated = siteConfig.legal.updated } = Astro.props;
---

<MarketingLayout title={title} description={description} look="plain">
  <div class="container-page">
    <article class="typeset mx-auto max-w-160 py-12 sm:py-16">
      <h1>{title}</h1>
      <p class="text-muted-foreground">Last updated {updated}</p>
      <slot />
    </article>
  </div>
</MarketingLayout>

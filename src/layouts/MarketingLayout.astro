---
import "@/styles/navy.css";
import BaseLayout from "./BaseLayout.astro";
import Navigation from "@/components/navy/global/Navigation.astro";
import Footer from "@/components/navy/global/Footer.astro";
import { DEFAULT_LOCALE, localizedPath, stripLocale } from "@/lib/i18n/locales";
import { pageLocales } from "@/lib/i18n/site";
import { pagePath } from "@/lib/page-path";
import { siteConfig } from "@/config/site";

interface Props {
  title: string;
  description?: string;
  /** Structured data for search engines, rendered as JSON-LD. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Docs pages take the slim footer (language, status, legal) to keep the reading column clean. */
  footer?: boolean | "slim";
  /** The page opens on a gradient hero (components/site/Hero): the navigation starts see-through with white links. */
  ink?: boolean;
}
const { title, description, jsonLd, footer = true, ink = false } = Astro.props;
const { locale, path } = stripLocale(pagePath(Astro.url.pathname));
// hreflang only on pages that exist in several languages (lib/i18n/site.ts).
const versions = pageLocales(path);
const alternates = versions.length > 1 ? versions.map((l) => ({ l, href: new URL(localizedPath(l, path), siteConfig.url).href })) : [];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} lang={locale} words={false}>
  <Fragment slot="head">
    {alternates.map((a) => <link rel="alternate" hreflang={a.l} href={a.href} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={alternates.find((a) => a.l === DEFAULT_LOCALE)!.href} />}
    <!-- Switzer, Navy's one typeface: https://www.fontshare.com/fonts/switzer -->
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=switzer@400,500,600,601&display=swap" />
  </Fragment>
  <!-- The navigation is fixed (strip 40 px + bar 56/64 px): pages without a gradient hero start under it (--header-height). -->
  <div class="navy relative flex min-h-svh flex-col [--header-height:calc(var(--spacing)*24)] lg:[--header-height:calc(var(--spacing)*26)]">
    <Navigation tone={ink ? "dark" : "light"} />
    <main id="main" tabindex="-1" class:list={["relative z-10 outline-none flex min-h-0 flex-1 flex-col", !ink && "pt-(--header-height)"]}><slot /></main>
    {footer ? <Footer slim={footer === "slim"} /> : null}
  </div>
</BaseLayout>

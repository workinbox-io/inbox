---
/**
 * Team chat: /app/chat and /app/chat/<channelId>. Members get it full screen next to mail (MailLayout and the app
 * rail); owners and admins inside the dashboard, like Notes.
 */
import AppRail from "@/components/workspace/AppRail.astro";
import AppTopBar from "@/components/workspace/AppTopBar.astro";
import { NotificationCenter } from "@/components/mailbox/notification-center";
import { ChatApp } from "@/components/chat/chat-app";
import AppLayout from "@/layouts/AppLayout.astro";
import MailLayout from "@/layouts/MailLayout.astro";
import { chatViewer } from "@/lib/server/chat/access";
import { listChannels } from "@/lib/server/chat/channels";
import { viewCounts } from "@/lib/server/chat/messages";
import { notePeople } from "@/lib/server/notes/notes";
import { canManage } from "@/lib/server/roles";
import { workspaceView } from "@/lib/server/workspace-view";
import { t } from "@/lib/i18n/panel";

const id = Astro.params.id ?? null;
if (id && !/^[0-9a-f-]{36}$/.test(id)) return Astro.redirect("/app/chat");

const role = Astro.locals.role ?? "member";
const user = Astro.locals.user!;
const viewer = chatViewer({ locals: Astro.locals, orgId: Astro.locals.orgId!, role });
const [channels, counts, people] = await Promise.all([listChannels(viewer), viewCounts(viewer), notePeople(viewer.orgId)]);
const userView = workspaceView(Astro.cookies, user.id, role) === "user";
const Layout = userView ? MailLayout : AppLayout;
---

<Layout title={t("Chat")} fullBleed>
  {!userView && (
    <Fragment slot="actions">
      <NotificationCenter client:load />
    </Fragment>
  )}
  <div class="flex h-full min-h-0">
    {userView && <AppRail current="chat" />}
    <div class="flex min-w-0 flex-1 flex-col">
      {userView && <AppTopBar title={t("Chat")} />}
      <div class="min-h-0 flex-1">
        <ChatApp
          client:load
          user={{ id: user.id, name: user.name, email: user.email }}
          channels={channels}
          counts={counts}
          people={people}
          selectedId={id}
          canManage={canManage(role)}
          account={userView ? { name: user.name, email: user.email } : undefined}
        />
      </div>
    </div>
  </div>
</Layout>

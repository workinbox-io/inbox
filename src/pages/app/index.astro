---
import AppLayout from "@/layouts/AppLayout.astro";
import { OverviewPanel } from "@/components/app/overview-panel";
import { listAudit } from "@/lib/server/audit";
import { getOrgUsage, getSubscription } from "@/lib/server/org";
import { canManage } from "@/lib/server/roles";

// Product: members use mail only (pages/app/mail.astro); the overview is for owners and admins.
if (!canManage(Astro.locals.role)) return Astro.redirect("/app/mail");
const orgId = Astro.locals.orgId!;
const [usage, sub, audit] = await Promise.all([
  getOrgUsage(orgId),
  getSubscription(orgId),
  canManage(Astro.locals.role) ? listAudit(orgId, { limit: 8 }) : null,
]);
const trialDaysLeft = sub?.trialEndsAt ? Math.ceil((sub.trialEndsAt.getTime() - Date.now()) / 86_400_000) : null;
---

<AppLayout title="Overview">
  <OverviewPanel
    client:load
    userName={Astro.locals.user!.name}
    plan={usage.plan}
    status={sub?.status ?? "trialing"}
    trialDaysLeft={trialDaysLeft}
    members={usage.members}
    recent={audit?.rows ?? null}
  />
</AppLayout>

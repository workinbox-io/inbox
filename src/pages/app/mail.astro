---
import { NotificationCenter } from "@/components/mailbox/notification-center";
import AppLayout from "@/layouts/AppLayout.astro";
import AppRail from "@/components/workspace/AppRail.astro";
import AppTopBar from "@/components/workspace/AppTopBar.astro";
import MailLayout from "@/layouts/MailLayout.astro";
import { MailboxApp } from "@/components/mailbox/mailbox-app";
import { viewerMailboxes } from "@/lib/server/mail/access";
import { listThreads, unreadCounts } from "@/lib/server/mail/store";
import { canManage } from "@/lib/server/roles";
import { workspaceView } from "@/lib/server/workspace-view";

const role = Astro.locals.role ?? "member";
const boxes = await viewerMailboxes({ orgId: Astro.locals.orgId!, userId: Astro.locals.user!.id, role });
const [list, unread] = await Promise.all([listThreads({ boxes, folder: "inbox" }), unreadCounts(boxes)]);
// The name each mailbox sends under: its sender name, else the viewer's (as sendMail does).
const signatures = Object.fromEntries(boxes.map((b) => [b.address, { signature: b.signature, name: b.displayName || Astro.locals.user!.name }]));
// Dates as ISO strings, like the API.
const threads = JSON.parse(JSON.stringify(list.threads));
// Members get mail only (MailLayout); owners and admins get it inside the dashboard.
const manager = canManage(role);
// Members get mail only (MailLayout); owners and admins pick the user or admin view (avatar menu, /app/view).
// Old links with ?view=mail|console still switch.
const requestedView = Astro.url.searchParams.get("view");
if (manager && (requestedView === "mail" || requestedView === "console"))
  return Astro.redirect(`/app/view?to=${requestedView === "mail" ? "user" : "admin"}&next=/app/mail`);
const mailOnly = workspaceView(Astro.cookies, Astro.locals.user!.id, role) === "user";
const Layout = mailOnly ? MailLayout : AppLayout;
const user = Astro.locals.user!;
---

<script>
  if ("serviceWorker" in navigator) navigator.serviceWorker.register("/mail-sw.js", { scope: "/app/" }).catch(() => {});
</script>
<Layout title="Mail" fullBleed>
  {!mailOnly && (
    <Fragment slot="actions">
      <NotificationCenter client:load />
    </Fragment>
  )}
  <div class="flex h-full min-h-0">
  {mailOnly && <AppRail current="mail" />}
  <div class="flex min-w-0 flex-1 flex-col">
  {/* The user view has its own bar; in the dashboard the same controls sit in its header (slot "actions"). */}
  {mailOnly && <AppTopBar title="Mail" />}
  <div class="min-h-0 flex-1">
  <MailboxApp
    client:load
    mailboxes={boxes.map((b) => b.address)}
    threads={threads}
    hasMore={list.hasMore}
    unread={unread}
    signatures={signatures}
    selectedId={Astro.url.searchParams.get("t")}
    canManage={manager}
    account={!mailOnly ? undefined : { name: user.name, email: user.email }}
    outbox={Astro.url.searchParams.get("pane") === "outbox"}
  />
  </div>
  </div>
  </div>
</Layout>

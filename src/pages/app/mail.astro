---
import AppLayout from "@/layouts/AppLayout.astro";
import MailLayout from "@/layouts/MailLayout.astro";
import { MailboxApp } from "@/components/mailbox/mailbox-app";
import { viewerMailboxes } from "@/lib/server/mail/access";
import { listThreads, unreadCounts } from "@/lib/server/mail/store";
import { canManage } from "@/lib/server/roles";

const role = Astro.locals.role ?? "member";
const boxes = await viewerMailboxes({ orgId: Astro.locals.orgId!, userId: Astro.locals.user!.id, role });
const [list, unread] = await Promise.all([listThreads({ boxes, folder: "inbox" }), unreadCounts(boxes)]);
const signatures = Object.fromEntries(boxes.map((b) => [b.address, { signature: b.signature }]));
// Dates as ISO strings, like the API.
const threads = JSON.parse(JSON.stringify(list.threads));
// Members get mail only (MailLayout); owners and admins get it inside the dashboard.
const manager = canManage(role);
const Layout = manager ? AppLayout : MailLayout;
const user = Astro.locals.user!;
---

<Layout title="Mail" fullBleed>
  <MailboxApp
    client:load
    mailboxes={boxes.map((b) => b.address)}
    threads={threads}
    hasMore={list.hasMore}
    unread={unread}
    signatures={signatures}
    selectedId={Astro.url.searchParams.get("t")}
    canManage={manager}
    account={manager ? undefined : { name: user.name, email: user.email }}
  />
</Layout>

---
/**
 * Shared notes: /app/notes and /app/notes/<id>. Members get them full screen next to mail (MailLayout and the
 * app rail); owners and admins inside the dashboard.
 */
import AppRail from "@/components/workspace/AppRail.astro";
import { NotesApp } from "@/components/notes/notes-app";
import AppLayout from "@/layouts/AppLayout.astro";
import MailLayout from "@/layouts/MailLayout.astro";
import { notesViewer } from "@/lib/server/notes/access";
import { listFolders, listNotes } from "@/lib/server/notes/notes";
import { canManage } from "@/lib/server/roles";
import { t } from "@/lib/i18n/panel";

const id = Astro.params.id ?? null;
if (id && !/^[0-9a-f-]{36}$/.test(id)) return Astro.redirect("/app/notes");

const role = Astro.locals.role ?? "member";
const user = Astro.locals.user!;
const viewer = notesViewer({ locals: Astro.locals, orgId: Astro.locals.orgId!, role });
const [list, folders] = await Promise.all([listNotes(viewer, { view: "all", limit: 50 }), listFolders(viewer.orgId)]);
const manager = canManage(role);
const Layout = manager ? AppLayout : MailLayout;
---

<Layout title={t("Notes")} fullBleed>
  <div class="flex h-full min-h-0">
    {!manager && <AppRail current="notes" />}
    <div class="min-w-0 flex-1">
      <NotesApp
        client:load
        user={{ id: user.id, name: user.name, email: user.email }}
        notes={list.notes}
        hasMore={list.hasMore}
        folders={folders}
        selectedId={id}
        canManage={manager}
        account={manager ? undefined : { name: user.name, email: user.email }}
      />
    </div>
  </div>
</Layout>

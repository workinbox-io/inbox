---
import AuthLayout from "@/layouts/AuthLayout.astro";
import { VerifyRecoveryEmail } from "@/components/mailbox/security-settings";
const token = Astro.url.searchParams.get("token") ?? "";
Astro.response.headers.set("Referrer-Policy", "no-referrer");
Astro.response.headers.set("Cache-Control", "no-store");
---
<AuthLayout title="Verify recovery email">
 <VerifyRecoveryEmail client:load token={token} />
</AuthLayout>

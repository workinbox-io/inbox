---
import SettingsLayout from "@/layouts/SettingsLayout.astro";
import { MailSettings } from "@/components/mailbox/mail-settings";
import { EmptyState } from "@/components/app/empty-state";
import { Lock } from "lucide-react";
import { listMailSetup } from "@/lib/server/mail/admin";
import { canManage } from "@/lib/server/roles";

const orgId = Astro.locals.orgId!;
const manager = canManage(Astro.locals.role);
const setup = manager ? JSON.parse(JSON.stringify(await listMailSetup(orgId))) : null;
---

<SettingsLayout description="Your domains, mailboxes and aliases.">
  {setup ? <MailSettings client:load initial={setup} /> : <EmptyState icon={<Lock />} title="Only owners and admins" description="Ask an owner or admin of your organization to change mail settings." />}
</SettingsLayout>

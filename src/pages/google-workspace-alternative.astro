---
/**
 * Landing page for "google workspace alternative(s)" (480 US searches a month each, KD 0; OpenSEO, 2026-11-09). The
 * results are list articles, so this page answers what a list can't: what a team keeps and gives up, and what five
 * people cost. Competitor facts from config/compare.ts (their own pages, `checked`).
 */
import { ArrowRight, Check, Minus } from "lucide-react";
import MarketingLayout from "@/layouts/MarketingLayout.astro";
import PageHero from "@/components/site/PageHero.astro";
import ClosingBand from "@/components/site/ClosingBand.astro";
import BrowserFrame from "@/components/site/BrowserFrame.astro";
import Shot from "@/components/site/Shot.astro";
import ComparisonTable from "@/components/site/ComparisonTable.astro";
import Faq from "@/components/site/Faq.astro";
import Stage from "@/components/site/craft/Stage.astro";
import InstallTimeline from "@/components/site/craft/InstallTimeline.astro";
import { COMPETITORS, competitorBySlug } from "@/config/compare";
import { FREE_PEOPLE, PLANS, TRIAL_DAYS } from "@/config/plans";
import { siteConfig } from "@/config/site";
import { siteLocale, tFor } from "@/lib/i18n/site";
import { localizedPath } from "@/lib/i18n/locales";

export const prerender = true;

const locale = siteLocale(Astro.url);
const t = tFor(locale);
const google = competitorBySlug("google-workspace")!;
const checked = new Date(google.checked).toLocaleDateString(locale === "en" ? "en-GB" : locale, { day: "numeric", month: "long", year: "numeric" });

/** Five people and one shared support@ mailbox, cheapest plan with custom-domain mail, annual billing, list prices before tax. */
const team = [
  { name: "Work Inbox Starter", each: `€${PLANS.starter.priceMonthly / 100}`, total: `€0 (up to ${FREE_PEOPLE} people free)`, shared: "Included, free" },
  { name: "Work Inbox self-hosted", each: "€0", total: "€0 + your Cloudflare usage", shared: "Included, free" },
  { name: "Google Workspace Business Starter", each: "$7", total: "$35", shared: "Google Groups' collaborative inbox" },
  { name: "Microsoft 365 Business Basic", each: "$7", total: "$35", shared: "Free up to 50 GB and 25 users" },
  { name: "Zoho Workplace Standard", each: "$3", total: "$15", shared: "Shared mailbox group" },
  { name: "Proton Mail Essentials", each: "$6.99", total: "$34.95", shared: "No shared mailboxes listed" },
];

const keep = [
  "Mail on your own domain, for every person",
  "Shared mailboxes like support@ and sales@",
  "Aliases, a catch-all and plus addressing",
  "Your old mail, imported from a Google Takeout .mbox",
  "Team chat with channels, DMs and threads, instead of Google Chat",
  "Notes your team edits together, live",
  "One address book for the team, with Google contacts imported",
  "A shared drive with folders, previews and public links",
  "Team calendars with invitations Gmail and Outlook users can answer",
  "Search with from:, has:attachment, is:unread",
  "Two-factor sign-in, an audit log and an API",
];
const giveUp = [
  "Calendar sync with phone apps over CalDAV, and booking pages (not yet)",
  "Sheets, Slides and Meet (not planned)",
  "Gmail's own phone apps (Work Inbox mail works in your phone's mail app over IMAP)",
];

const steps = [
  { title: "Add the domain", text: "In Settings → Mail. Work Inbox shows the DNS records it needs (MX, DKIM, DMARC); on Cloudflare, Connect Cloudflare adds them." },
  { title: "Add your people", text: "Each person gets a mailbox with the same address they had in Gmail." },
  { title: "Switch the MX records", text: "Replace Google's MX records with the one Work Inbox lists. New mail arrives in Work Inbox; keep Google as an archive." },
];

const faq = [
  ...google.faq,
  { question: "Is there a free Google Workspace alternative?", answer: `Work Inbox is free when you run it on your own Cloudflare account; you pay Cloudflare for what you use. Hosted, up to ${FREE_PEOPLE} people are free for good, with shared mailboxes, aliases and notes; a bigger team pays from €${PLANS.starter.priceMonthly / 100} a person a month, the first ${FREE_PEOPLE} still free. Zoho Mail also has a free plan for up to five people, without shared mailboxes.` },
  { question: "Is there an open-source Google Workspace alternative?", answer: "Work Inbox is open source and runs on Cloudflare. Nextcloud is open source too and covers files, calendar and office documents, but it has no mail server of its own." },
];

const questions = faq.map((f) => ({ question: t(f.question), answer: t(f.answer) }));
const url = (path: string) => (Astro.site ? new URL(localizedPath(locale, path), Astro.site).href : path);
const jsonLd = [
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: questions.map((f) => ({ "@type": "Question", name: f.question, acceptedAnswer: { "@type": "Answer", text: f.answer } })) },
  { "@context": "https://schema.org", "@type": "WebPage", name: t("Google Workspace alternative"), url: url("/google-workspace-alternative"), dateModified: google.checked },
];
---

<MarketingLayout title={t("Open-source Google Workspace alternative")} description={t("An open-source Google Workspace alternative: email on your own domain, chat, shared notes, calendars, a shared drive and contacts, free for up to five people, then €1 a person, or self-hosted. What you keep, what you give up, what five people cost.")} jsonLd={jsonLd} ink>
  <PageHero>
    <h1 class="mk-h1 max-w-4xl">{t("Leave Google,")} <em>{t("keep your addresses.")}</em></h1>
    <p class="mk-lead mt-6 max-w-2xl">
      {t("Work Inbox is an open-source workspace: email on your own domain, chat, notes, calendars, a shared drive and contacts. It does less than Google Workspace, costs less, and can run on your own Cloudflare account.")}
    </p>
    <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-3">
      <a href="/signup" class="mk-btn">{t("Start free")} <ArrowRight className="size-5" /></a>
      <a href="/docs/self-host" class="mk-link">{t("Self-host on Cloudflare")}</a>
    </div>
  </PageHero>
  <div class="mk-wrap flex flex-1 flex-col pb-20 sm:pb-28">

    <div class="mt-14"><Stage><BrowserFrame url="workinbox.io/app/mail"><Shot name="mail-thread" alt={t("Work Inbox mail with an open message")} eager /></BrowserFrame></Stage></div>

    <section class="grid gap-10 pt-20 md:grid-cols-2">
      <div>
        <h2 class="text-[clamp(1.7rem,3vw,2.4rem)]">{t("What you keep")}</h2>
        <ul class="mt-5 space-y-3">{keep.map((k) => <li class="flex gap-2.5"><Check className="mt-1 size-4 shrink-0" />{t(k)}</li>)}</ul>
      </div>
      <div>
        <h2 class="text-[clamp(1.7rem,3vw,2.4rem)]">{t("What you give up,")} <em>{t("for now")}</em></h2>
        <ul class="mt-5 space-y-3">{giveUp.map((k) => <li class="flex gap-2.5"><Minus className="mt-1 size-4 shrink-0 text-foreground/50" />{t(k)}</li>)}</ul>
      </div>
    </section>

    <section class="pt-20">
      <h2 class="text-[clamp(1.7rem,3vw,2.4rem)]">{t("What five people and a support@ mailbox cost")}</h2>
      <p class="mt-2 text-sm text-foreground/60">{t("The cheapest plan with mail on your own domain, a month, billed yearly, list prices before tax, in the currency each vendor shows.")} {t("Checked {date}.", { date: checked })}</p>
      <div class="mt-6 overflow-x-auto rounded-2xl border border-(--border) bg-(--card)">
        <table class="w-full min-w-[560px] text-left text-sm">
          <thead><tr class="border-b border-(--border)"><th class="p-4 font-medium">{t("Plan")}</th><th class="p-4 font-medium">{t("Per person")}</th><th class="p-4 font-medium">{t("Five people")}</th><th class="p-4 font-medium">{t("The shared mailbox")}</th></tr></thead>
          <tbody>
            {team.map((r, i) => (
              <tr class:list={["border-b border-(--border) last:border-0", i < 2 && "bg-(--accent)"]}>
                <th scope="row" class="p-4 font-medium">{r.name}</th><td class="p-4 tabular-nums">{t(r.each)}</td><td class="p-4 tabular-nums">{t(r.total)}</td><td class="p-4">{t(r.shared)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="pt-20">
      <h2 class="text-[clamp(1.7rem,3vw,2.4rem)]">{t("Feature by feature")}</h2>
      <div class="mt-6"><ComparisonTable competitors={[google, competitorBySlug("microsoft-365")!, competitorBySlug("zoho-mail")!]} /></div>
      <p class="mt-4 text-sm text-foreground/60">{t("More detail, with sources:")} {COMPETITORS.map((c, i) => <>{i ? ", " : ""}<a href={`/vs/${c.slug}`} class="underline underline-offset-4">{c.name}</a></>)}.</p>
    </section>

    <section class="pt-20">
      <h2 class="text-[clamp(1.7rem,3vw,2.4rem)]">{t("Moving your domain's mail")}</h2>
      <div class="mt-10"><InstallTimeline steps={steps.map((s) => ({ title: t(s.title), text: t(s.text) }))} /></div>
    </section>

    <section class="pt-20">
      <h2 class="text-[clamp(1.7rem,3vw,2.4rem)]">{t("Questions")}</h2>
      <div class="mt-6 max-w-3xl"><Faq items={questions} /></div>
    </section>
  </div>
  <ClosingBand />
</MarketingLayout>

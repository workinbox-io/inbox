    </div>
  </section>

  <!-- FAQ. -->
  <section id="faq" class="mk-wrap mk-section scroll-mt-16">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
      <div>
        <h2 class="mk-h2">{t("Questions")}</h2>
        <p class="mk-lead mt-4">{t("Something else? Write to")} <a href={`mailto:${siteConfig.supportEmail}`} class="mk-link text-(--foreground)">{siteConfig.supportEmail}</a>.</p>

  <ClosingBand />
</MarketingLayout>

<style>
  .hero-app {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.75rem;
    border: 1px solid rgb(255 255 255 / 0.2);
    font-size: 0.875rem;
    color: rgb(255 255 255 / 0.85);
    transition: background-color 0.15s, border-color 0.15s;
  }
  .hero-app:hover,
  .hero-app:focus-visible,
  .hero-app.is-lit {
    background: rgb(255 255 255 / 0.1);
    border-color: rgb(255 255 255 / 0.6);
    color: #fff;
  }
  .setup-step {
    border-left: 2px solid transparent;
    transition: background-color 0.15s, border-color 0.15s;
  }
  .setup-step:hover,
  .setup-step[aria-pressed="true"] {
    background: var(--mk-grey);
  }
  .setup-step[aria-pressed="true"] {
    border-color: var(--mk-accent);
  }
  .setup-step:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }
  .race-row {
    display: grid;
    grid-template-columns: minmax(6rem, 10rem) minmax(0, 1fr) 5rem;
    align-items: center;
    gap: 0 1rem;
    padding: 0.5rem 0;
  }
  .race-row:hover .race-track {
    opacity: 0.8;
  }
  .race-track {
    position: relative;
    height: 1.5rem;
  }
  .race-marker {
    position: absolute;
    top: 50%;
    left: calc(var(--x) - 1.5rem * var(--x) / 100%);
    translate: 0 -50%;
    padding-inline: 2px;
    background: var(--mk-grey);
    color: var(--mk-accent);
    transition: left 1.6s cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: calc(var(--i) * 120ms);
  }
  .race-row.font-medium .race-marker {
    color: var(--mk-accent);
  }
  .race-row:not(.font-medium) .race-marker {
    color: color-mix(in srgb, var(--mk-accent) 50%, transparent);
  }
  [data-race]:not([data-race-on]) .race-marker {
    left: 0;
    transition: none;
  }
  .calc-range {
    accent-color: var(--mk-accent);
  }
  .calc-plan {
    transition: background-color 0.15s, color 0.15s;
  }
  .calc-plan:hover {
    background: var(--mk-grey);
  }
  .calc-plan[aria-pressed="true"] {
    color: var(--mk-on-accent);
    background: var(--mk-accent);
    border-color: var(--mk-accent);
  }
  .calc-plan:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }
  .calc-plan-cap {
    opacity: 0.7;
  }
  @media (prefers-reduced-motion: reduce) {
    .race-marker {
      transition: none;
    }
  }
</style>

<script>
  import "@/scripts/demo-progress";
  // The hero's belt: a chute or an app link under the pointer (or focused) lights both up.
  const belt = document.querySelector<HTMLElement>("[data-belt]");
  const beltScene = belt?.querySelector<HTMLCanvasElement>("canvas");
  if (belt && beltScene) {
    const links = [...document.querySelectorAll<HTMLElement>("[data-app]")];
    const light = (i: string) => {
      beltScene.dataset.state = i;
      for (const l of links) l.classList.toggle("is-lit", l.dataset.app === i);
    };
    for (const el of [...belt.querySelectorAll<HTMLElement>("[data-chute]"), ...links]) {
      const i = el.dataset.chute ?? el.dataset.app ?? "";
      el.addEventListener("pointerenter", () => light(i));
      el.addEventListener("focus", () => light(i));
      el.addEventListener("pointerleave", () => light(""));
      el.addEventListener("blur", () => light(""));
    }
  }

  // Setup steps: the step pointed at, focused or clicked (on phones: scrolled to the middle) fills the scene up to it.
  const setup = document.querySelector<HTMLElement>("[data-setup]");
  if (setup) {
    const statuses: string[] = JSON.parse(setup.dataset.setup!);
    const scene = setup.querySelector<HTMLCanvasElement>("canvas")!;
    const buttons = [...setup.querySelectorAll<HTMLButtonElement>("[data-setup-step]")];
    const pick = (i: number) => {
      buttons.forEach((b, n) => b.setAttribute("aria-pressed", String(n === i)));
      scene.dataset.state = String(i + 1);
      setup.querySelector("[data-setup-status]")!.textContent = statuses[i]!;
      setup.querySelector("[data-setup-dot]")!.classList.replace("bg-white/50", "bg-white");
    };
    buttons.forEach((b, i) => {
      for (const type of ["pointerenter", "focus", "click"]) b.addEventListener(type, () => pick(i));
    });
    const middle = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) pick(buttons.indexOf(e.target as HTMLButtonElement));
    }, { rootMargin: "-45% 0px -45% 0px" });
    for (const b of buttons) middle.observe(b);
  }

  // The race: markers slide in when the chart comes into view; Replay runs it again.
  const race = document.querySelector<HTMLElement>("[data-race]");
  if (race) {
    const run = () => {
      race.removeAttribute("data-race-on");
      void race.offsetWidth;
      race.setAttribute("data-race-on", "");
    };
    new IntersectionObserver(([e], o) => {
      if (e?.isIntersecting) {
        run();
        o.disconnect();
      }
    }, { threshold: 0.3 }).observe(race);
    race.querySelector("[data-race-replay]")!.addEventListener("click", run);
  }

  // Pricing calculator: people × plan × billing, FREE_PEOPLE free, at least MIN_SEATS billed (seatsFor).
  const calc = document.querySelector<HTMLElement>("[data-calc]");
  if (calc) {
    const plans: { id: string; name: string; monthly: number; yearly: number }[] = JSON.parse(calc.dataset.plans!);
    const free = Number(calc.dataset.free);
    const min = Number(calc.dataset.min);
    const words: { lang: string; month: string; year: string; free: Record<string, string>; atLeast: string; formula: string } = JSON.parse(calc.dataset.words!);
    const fill = (text: string, vars: Record<string, string | number>) => text.replace(/\{(\w+)\}/g, (m, k: string) => (k in vars ? String(vars[k]) : m));
    const eur = (n: number) => new Intl.NumberFormat(words.lang, { style: "currency", currency: "EUR", maximumFractionDigits: Number.isInteger(n) ? 0 : 2 }).format(n);
    const peopleInput = calc.querySelector<HTMLInputElement>("[data-calc-people-input]")!;
    peopleInput.addEventListener("input", () => render());
    const value = (key: string) => calc.querySelector<HTMLElement>(`[data-calc-key="${key}"] [aria-pressed="true"]`)!.dataset.value!;
    const render = () => {
      const people = Number(peopleInput.value);
      calc.querySelector("[data-calc-people]")!.textContent = String(people);
      const plan = plans.find((p) => p.id === value("plan"))!;
      const yearly = value("billing") === "year";
      const each = yearly ? plan.yearly : plan.monthly;
      const paid = people <= free ? 0 : Math.max(min, people - free);
      const total = paid * each;
      calc.querySelector("[data-calc-total]")!.textContent = eur(total);
      calc.querySelector("[data-calc-unit]")!.textContent = yearly ? words.year : words.month;
      const vars = { people, free, min, each: eur(each), total: eur(total) };
      calc.querySelector("[data-calc-formula]")!.textContent =
        paid === 0
          ? fill(words.free[new Intl.PluralRules(words.lang).select(people)] ?? words.free.other!, vars)
          : people - free < min
            ? fill(words.atLeast, vars)
            : fill(words.formula, vars);
    };
    for (const group of calc.querySelectorAll<HTMLElement>("[data-calc-key]")) {
      group.addEventListener("click", (e) => {
        const button = (e.target as Element).closest<HTMLButtonElement>("button");
        if (!button) return;
        for (const b of group.querySelectorAll("button")) b.setAttribute("aria-pressed", String(b === button));
        render();
      });
    }
    render();
  }

  // Tour tabs: arrow keys move between them, the address bar follows.
  const tour = document.querySelector<HTMLElement>("[data-tabs]");
  if (tour) {
    const buttons = [...tour.querySelectorAll<HTMLButtonElement>("[data-tab]")];
    const url = tour.querySelector<HTMLElement>("[data-url]")!;
    const select = (btn: HTMLButtonElement) => {
      for (const b of buttons) {
        const on = b === btn;
        b.setAttribute("aria-selected", String(on));
        b.tabIndex = on ? 0 : -1;
        const panel = tour.querySelector<HTMLElement>(`[data-panel="${b.dataset.tab}"]`)!;
        panel.hidden = !on;
        if (on) url.textContent = panel.dataset.urlValue ?? "";
      }
    };
    buttons.forEach((b, n) => {
      b.tabIndex = n === 0 ? 0 : -1;
      b.addEventListener("click", () => select(b));
      b.addEventListener("keydown", (e) => {
        const d = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        const next = buttons[(n + d + buttons.length) % buttons.length]!;
        select(next);
        next.focus();
      });
    });
    // /#tour-notes, /#tour-drive…: the header's Product menu opens the tour on that screen.
    const fromHash = () => {
      const btn = buttons.find((b) => location.hash === `#tour-${b.dataset.tab}`);
      if (!btn) return;
      select(btn);
      tour.scrollIntoView();
    };
    fromHash();
    addEventListener("hashchange", fromHash);
  }
</script>

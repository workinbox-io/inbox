    <div class="mk-wrap pb-20 sm:pb-28">
      <h3 class="text-xl">{t("Next to Google Workspace and Microsoft 365")}</h3>
      <div class="mt-6"><ComparisonTable competitors={bigSuites} rows={["selfHost", "shared", "imap", "ai", "suite"]} /></div>
    </div>
  </section>

  <!-- Pricing: toggles and the price they make. -->
  <section id="pricing" class="mk-wrap mk-section scroll-mt-16">
    <h2 class="mk-h2">{t("The whole workspace, per person")}</h2>
    <p class="mk-lead mt-3">
      {t("One price covers the whole workspace: mail, chat, notes, calendars, drive and contacts. The first {n} people, shared mailboxes and aliases cost nothing; after that, from {price} a person a month.", { n: FREE_PEOPLE, price: money(lowest, CURRENCY) })}
    </p>
    <div class="mt-12 grid gap-12 lg:grid-cols-2 lg:gap-16" data-calc data-free={FREE_PEOPLE} data-min={MIN_SEATS} data-plans={JSON.stringify(plans)} data-words={JSON.stringify(calcWords)}>
      <div>
        <div class="flex items-baseline justify-between text-sm">
          <label for="calc-people">{t("People in your workspace")}</label>
          <output for="calc-people" class="font-[family-name:var(--mk-font-mono)] text-base tabular-nums" data-calc-people>10</output>
        </div>
        <input id="calc-people" type="range" min="1" max="100" value="10" class="calc-range mt-3 w-full" data-calc-people-input />
        <div class="mk-cap mt-1 flex justify-between"><span>1</span><span>100</span></div>

        <p class="mt-8 text-sm" id="calc-plan-label">{t("Plan")}</p>
        <div class="mt-3 grid grid-cols-3 gap-2" role="group" aria-labelledby="calc-plan-label" data-calc-key="plan">
          {
            PLAN_LIST.map((p) => (
              <button type="button" class="calc-plan mk-frame p-3 text-left sm:p-4" aria-pressed={String(p.id === "starter")} data-value={p.id}>
                <span class="block text-sm font-medium">{p.name}</span>
                <span class="mt-1 block font-[family-name:var(--mk-font-display)] text-2xl tabular-nums sm:text-3xl">{money(p.priceMonthly / 100, CURRENCY)}</span>
                <span class="calc-plan-cap mt-2 block font-[family-name:var(--mk-font-mono)] text-xs">
                  {t("{gb} GB drive", { gb: p.driveGbPerPerson })}
                  <br />
                  {hasFeature(p, "mcpAccess") ? t("+ API, AI apps, audit") : t("whole workspace")}
                </span>
              </button>
            ))
          }
        </div>
        <p class="mk-cap mt-2">{t("per person a month")}</p>

        <div class="mk-seg mt-8" data-calc-key="billing">
          <button type="button" aria-pressed="true" data-value="month">{t("monthly")}</button>
          <button type="button" aria-pressed="false" data-value="year">{t("yearly · 2 months free")}</button>
        </div>

        <p class="mt-10 flex items-baseline gap-2" aria-live="polite">
          <span class="font-[family-name:var(--mk-font-display)] text-6xl font-medium tracking-tight tabular-nums sm:text-7xl" data-calc-total>{money(5, CURRENCY)}</span>
          <span class="text-lg" data-calc-unit>{calcWords.month}</span>
        </p>
        <p class="mk-cap mt-2" data-calc-formula>{t("({people} − {free} free) × {each} = {total}", { people: 10, free: FREE_PEOPLE, each: money(1, CURRENCY), total: money(5, CURRENCY) })}</p>
        <p class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3">
          <a href="/signup" class="mk-btn">{t("Start free")}</a>
          <span class="mk-cap">{t("{days}-day trial, no card · prices exclude VAT", { days: TRIAL_DAYS })}</span>
        </p>
      </div>
      <div>
        <h3 class="text-xl">{t("Every plan includes")}</h3>
        <ul class="mk-sqlist mt-4 text-lg">
          <li>{t("Unlimited shared mailboxes, aliases and a catch-all per domain.")}</li>
          <li>{t("The whole workspace: team chat, live shared notes, a team address book, a shared drive and calendars.")}</li>
          <li>{t("Drafts on every device, signatures in your company's style.")}</li>
          <li>{t("Spam filter, sender rules and search across every mailbox.")}</li>
          <li>{t("Up to {n} people free, for good.", { n: FREE_PEOPLE })}</li>
        </ul>
        <h3 class="mt-10 text-xl">{t("Not yet")}</h3>
        <ul class="mk-sqlist mt-4 text-lg">
          <li>{t("Native mobile apps: use your phone's mail app over IMAP, or install the web app.")}</li>
          <li>{t("CalDAV sync and booking pages for the calendar.")}</li>
        </ul>
        <p class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-lg">
          <a href={lp(locale, "/pricing")} class="mk-link">{t("Pricing details")}</a>
          <a href="/docs/self-host" class="mk-link">{t("Self-host for free")}</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Ink band: what the team owns. -->
  <section id="own" class="mk-band scroll-mt-16">
    <div class="mk-wrap mk-section">
      <p class="max-w-4xl font-[family-name:var(--mk-font-display)] text-[clamp(1.75rem,2.6vw,2.4rem)] leading-tight font-medium tracking-tight text-balance">
        {t("Yours to own. Every line that touches your mail, chats and files is public. Run it on your own Cloudflare account, or let us run the same code.")}
      </p>
      <ul class="mt-12 grid gap-px bg-white/15 sm:grid-cols-2 lg:grid-cols-3">
        {
          ownItems.map((o) => (
            <li class="bg-(--mk-band) p-6">
              <o.icon className="size-5 opacity-70" />
              <p class="mt-4 font-medium">{o.href ? <a href={o.href} class="mk-link">{o.title}</a> : o.title}</p>
              <p class="mt-2 text-white/65">{o.text}</p>

  </section>

  <!-- Grey band: Google and Microsoft side by side, a race of envelopes for the price, then the facts. -->
  <section id="compare" class="mk-band-grey scroll-mt-16">
    <div class="mk-wrap mk-section grid gap-12 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16" data-race>
      <div>
        <h2 class="mk-h2">{t("What a team of {n} pays", { n: TEAM })}</h2>
        <p class="mk-lead mt-4">
          {t("A month on each entry plan with your own domain, billed yearly where that is the only option. Ours covers every app: mail, chat, notes, calendars, drive and contacts, and the first {n} people are free. Prices as each vendor lists them on {date}, € and $ not converted.", { n: FREE_PEOPLE, date: checked ?? "" })}
        </p>
        <button type="button" class="mk-btn mk-btn-ghost mt-8" data-race-replay>▶ {t("Replay")}</button>
        <p class="mt-5"><a href="/vs" class="mk-link">{t("Full comparisons, with sources")}</a></p>
      </div>
      <ol class="grid gap-1 font-[family-name:var(--mk-font-mono)] text-sm">
        {
          race.map((r, i) => (

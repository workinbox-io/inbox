              <a href={lp(locale, r.href)} class:list={["race-row", r.ours && "font-medium"]} style={`--x: ${(r.amount / raceMax) * 100}%; --i: ${i}`}>
                <span class="truncate">{r.name}</span>
                <span class="race-track mk-dots">
                  <span class="race-marker"><PixelIcon rows={ICONS.mail} class="h-4 w-6" /></span>
                </span>
                <span class="text-right tabular-nums">{money(r.amount, r.currency)}</span>

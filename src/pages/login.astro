---
import { t } from "@/lib/i18n/panel";
import AuthLayout from "@/layouts/AuthLayout.astro";
import { AuthForm } from "@/components/auth/auth-form";
import { getAuth } from "@/lib/server/auth";
import { safeNext } from "@/lib/signup";

const nextParam = Astro.url.searchParams.get("next") ?? "/app";
const next = safeNext(nextParam);
const email = Astro.url.searchParams.get("email") ?? undefined;

// Already signed in: skip the form. Unless an app's OAuth request asks to sign in again (signed `sig`).
const oauth = Astro.url.searchParams.has("sig");
if (!oauth && (await getAuth().api.getSession({ headers: Astro.request.headers }))) return Astro.redirect(next);
---

<AuthLayout title={t("Sign in")} noindex>
  <AuthForm client:load mode="login" next={next} email={email} />
</AuthLayout>

---
/** Polish twin of /vs/<slug>. */
import Page from "../../vs/[slug].astro";
import { COMPETITORS } from "@/config/compare";

export const prerender = true;
export function getStaticPaths() {
  return COMPETITORS.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props;
---

<Page c={c} />

---
import MarketingLayout from "@/layouts/MarketingLayout.astro";
import PageHero from "@/components/site/PageHero.astro";
import ClosingBand from "@/components/site/ClosingBand.astro";
import SectionHeading from "@/components/site/SectionHeading.astro";
import PricingCards from "@/components/site/PricingCards.astro";
import Faq from "@/components/site/Faq.astro";
import { CURRENCY, PLAN_LIST, TRIAL_DAYS, TRIAL_PLAN, PLANS } from "@/config/plans";
import { siteConfig } from "@/config/site";

export const prerender = true;

const faq = [
  { question: "Who counts as a person?", answer: "Everyone with a personal mailbox on your domains, and the first one is free: a team of five pays for four. Shared mailboxes like support@ and aliases like hello@ are free and unlimited." },
  { question: "Is there a free plan?", answer: "Yes. One person is free for good: a personal mailbox on your own domain, plus shared mailboxes, aliases, catch-all and notes. A plan is needed from the second person, and the first person stays free on it. On your own, a plan for the API, the AI connector or the audit log is billed for one person." },
  { question: "How does the trial work?", answer: `You get ${TRIAL_DAYS} days of ${PLANS[TRIAL_PLAN].name} without a card. Choose a plan any time from the Billing page; if you stay one person, mail keeps working for free after the trial.` },
  { question: "What does self-hosting cost?", answer: "Nothing to us. Work Inbox is open source; on your own Cloudflare account you pay Cloudflare for Workers, D1, R2 and e-mail sending, usually on the Workers Paid plan." },
  { question: "Can I change plans later?", answer: "Yes, upgrade or downgrade from Billing. Paddle prorates the difference." },
  { question: "Do you charge VAT?", answer: "Prices exclude VAT. Paddle, our merchant of record, adds it at checkout where it applies." },
];

const url = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: siteConfig.name,
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    url: url("/pricing"),
    offers: PLAN_LIST.map((p) => ({ "@type": "Offer", name: p.name, price: p.priceMonthly / 100, priceCurrency: CURRENCY, description: "Per person (personal mailbox) a month, the first person free" })),
  },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faq.map((f) => ({ "@type": "Question", name: f.question, acceptedAnswer: { "@type": "Answer", text: f.answer } })) },
];
---

<MarketingLayout title="Pricing" description={`${siteConfig.name} pricing: free for one person, then from €${PLANS.starter.priceMonthly / 100} per person a month, shared mailboxes free, self-hosted free. ${TRIAL_DAYS}-day trial, no card needed.`} jsonLd={jsonLd} ink>
  <PageHero>
    <h1 class="mk-h1 max-w-4xl">The first person is free. <em>Then pay per person.</em></h1>
    <p class="mk-lead mt-6 max-w-2xl">
      Shared mailboxes and aliases are free on every plan. {TRIAL_DAYS}-day free trial, no card needed. Pay yearly and get two months free. Prices exclude VAT.
    </p>
  </PageHero>
  <div class="mk-wrap flex flex-1 flex-col pb-20 sm:pb-28">
    <div data-reveal="items" class="mt-12 sm:mt-16"><PricingCards yearly /></div>
    <section class="pt-24">
      <SectionHeading muted="about plans.">Questions</SectionHeading>
      <div class="mt-10 w-full max-w-3xl"><Faq items={faq} /></div>
    </section>
  </div>
  <ClosingBand />
</MarketingLayout>

---
import MarketingLayout from "@/layouts/MarketingLayout.astro";
import Hero from "@/components/site/Hero.astro";
import Wrapper from "@/components/navy/fundations/containers/Wrapper.astro";
import { StatusBoard } from "@/components/status/status-board";
import { getStatusOverview } from "@/lib/server/status";
import { siteConfig } from "@/config/site";

const overview = await getStatusOverview();
Astro.response.headers.set("Cache-Control", "public, max-age=30");
---

<MarketingLayout
  title="Status"
  description="Live status and 90-day uptime of Work Inbox: the web app and API, files, sending mail and mail apps."
  ink
>
  <Hero>
    <Fragment slot="title">System <em>status.</em></Fragment>
    <Fragment slot="text">
      We check every part of {siteConfig.name} once a minute. Questions? Write to{" "}
      <a class="inline-block py-1 border-b border-inverse-foreground/50" href={`mailto:${siteConfig.supportEmail}`}>{siteConfig.supportEmail}</a>.
    </Fragment>
  </Hero>
  <Wrapper variant="standard" class="w-full pb-24">
    <div class="w-full max-w-3xl mx-auto">
      <StatusBoard client:load overview={overview} />
    </div>
  </Wrapper>
</MarketingLayout>

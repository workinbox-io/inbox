---
/** WorkInbox vs one competitor, from config/compare.ts. */
import { ArrowRight, Check } from "lucide-react";
import MarketingLayout from "@/layouts/MarketingLayout.astro";
import ComparisonTable from "@/components/site/ComparisonTable.astro";
import Faq from "@/components/site/Faq.astro";
import { COMPETITORS, type Competitor } from "@/config/compare";
import { TRIAL_DAYS } from "@/config/plans";
import { siteConfig } from "@/config/site";

export const prerender = true;
export function getStaticPaths() {
  return COMPETITORS.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props as { c: Competitor };
const others = COMPETITORS.filter((o) => o.slug !== c.slug);
const checked = new Date(c.checked).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
const url = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Compare", item: url("/vs") },
      { "@type": "ListItem", position: 2, name: `${siteConfig.name} vs ${c.name}`, item: url(`/vs/${c.slug}`) },
    ],
  },
  ...(c.faq.length
    ? [{ "@context": "https://schema.org", "@type": "FAQPage", mainEntity: c.faq.map((f) => ({ "@type": "Question", name: f.question, acceptedAnswer: { "@type": "Answer", text: f.answer } })) }]
    : []),
];
---

<MarketingLayout title={`${siteConfig.name} vs ${c.name}`} description={`${c.intro.split(". ")[0]}. Prices, shared mailboxes, self-hosting and what each does better, checked ${checked}.`} jsonLd={jsonLd}>
  <div class="mx-auto flex w-full max-w-[1120px] flex-1 flex-col px-5 pb-8 sm:px-10">
    <nav class="pt-10 text-sm text-foreground/60"><a href="/vs" class="hover:text-foreground">Compare</a> / {c.name}</nav>
    <header class="pt-8">
      <p class="text-sm font-medium tracking-wide text-foreground/60 uppercase">{siteConfig.name} vs {c.name}</p>
      <h1 class="hero-title mt-4 max-w-4xl text-[clamp(2.3rem,4.6vw,4rem)]">{c.tagline}</h1>
      <p class="mt-6 max-w-2xl text-lg leading-7 text-pretty text-foreground/65">{c.intro}</p>
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
        <a href="/signup" class="mk-btn">Start free trial <ArrowRight className="size-5" /></a>
        <span class="text-sm text-foreground/60">{TRIAL_DAYS} days, no card. Or self-host for free.</span>
      </div>
    </header>

    <section class="pt-16">
      <h2 class="text-[clamp(1.7rem,3vw,2.4rem)]">Side by side</h2>
      <p class="mt-2 text-sm text-foreground/60">{c.name}'s facts from its own pages, checked {checked}. Prices as {c.name} shows them, before tax.</p>
      <div class="mt-6"><ComparisonTable competitors={[c]} /></div>
    </section>

    <section class="pt-16">
      <h2 class="text-[clamp(1.7rem,3vw,2.4rem)]">{c.name}'s plans</h2>
      <ul class="mt-5 space-y-2 text-foreground/75">{c.theirPricing.map((p) => <li class="flex gap-2.5"><span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-foreground/40" />{p}</li>)}</ul>
    </section>

    <section class="grid gap-10 pt-16 md:grid-cols-2">
      <div>
        <h2 class="text-[clamp(1.6rem,2.6vw,2.1rem)]">Why teams pick {siteConfig.name}</h2>
        <ul class="mt-5 space-y-3">{c.whyUs.map((p) => <li class="flex gap-2.5"><Check className="mt-1 size-4 shrink-0" />{p}</li>)}</ul>
      </div>
      <div>
        <h2 class="text-[clamp(1.6rem,2.6vw,2.1rem)]">Pick {c.name} if</h2>
        <ul class="mt-5 space-y-3">{c.pickThemIf.map((p) => <li class="flex gap-2.5"><Check className="mt-1 size-4 shrink-0 text-foreground/50" />{p}</li>)}</ul>
      </div>
    </section>

    {
      c.faq.length ? (
        <section class="pt-16">
          <h2 class="text-[clamp(1.7rem,3vw,2.4rem)]">Questions</h2>
          <div class="mt-6 max-w-3xl"><Faq items={c.faq} /></div>
        </section>
      ) : null
    }

    <section class="pt-16">
      <h2 class="text-xl">Sources</h2>
      <ul class="mt-3 space-y-1 text-sm break-all text-foreground/60">{c.sources.map((s) => <li><a href={s} rel="nofollow noopener" target="_blank" class="underline underline-offset-4 hover:text-foreground">{s}</a></li>)}</ul>
    </section>

    <section class="pt-16">
      <h2 class="text-xl">Other comparisons</h2>
      <div class="mt-4 flex flex-wrap gap-2">
        {others.map((o) => <a href={`/vs/${o.slug}`} class="rounded-full border border-(--border) px-4 py-2 text-sm hover:bg-(--accent)">vs {o.name}</a>)}
      </div>
    </section>
  </div>
</MarketingLayout>

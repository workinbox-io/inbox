---
/** All comparisons on one page: the table across every competitor, then a link to each detail page. */
import MarketingLayout from "@/layouts/MarketingLayout.astro";
import Hero from "@/components/site/Hero.astro";
import Section from "@/components/site/Section.astro";
import Features from "@/components/site/Features.astro";
import ComparisonTable from "@/components/site/ComparisonTable.astro";
import { COMPETITORS } from "@/config/compare";
import { siteConfig } from "@/config/site";
import { siteLocale, tFor, lp } from "@/lib/i18n/site";
import { localizedPath } from "@/lib/i18n/locales";

export const prerender = true;

const locale = siteLocale(Astro.url);
const t = tFor(locale);
const url = (path: string) => (Astro.site ? new URL(localizedPath(locale, path), Astro.site).href : path);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: COMPETITORS.map((c, i) => ({ "@type": "ListItem", position: i + 1, name: `${siteConfig.name} ${t("vs")} ${c.name}`, url: url(`/vs/${c.slug}`) })),
};
---

<MarketingLayout title={t("Compare Work Inbox with Google Workspace, Microsoft 365 and others")} description={t("Work Inbox next to Google Workspace, Microsoft 365, Zoho Mail, Proton, Fastmail and Nextcloud: prices, shared mailboxes, self-hosting and what each does better.")} jsonLd={jsonLd} ink>
  <Hero>
    <Fragment slot="title">{t("How Work Inbox compares,")}{" "}<em>{t("with sources.")}</em></Fragment>
    <Fragment slot="text">{t("Every fact about another product comes from its own pricing and help pages, linked on each comparison. Where they do something better, the page says so.")}</Fragment>
  </Hero>
  <Section label={t("Compare")}>
    <Fragment slot="title">{t("Side by side")}</Fragment>
    <div slot="full">
      <ComparisonTable competitors={COMPETITORS.filter((c) => ["google-workspace", "microsoft-365", "zoho-mail"].includes(c.slug))} />
      <Features cols={3} class="mt-16" items={COMPETITORS.map((c) => ({ tag: t("Compare"), title: `${t("vs")} ${c.name}`, text: t(c.tagline), href: lp(locale, `/vs/${c.slug}`) }))} />
    </div>
  </Section>
</MarketingLayout>

// Cloudflare config. `pnpm setup` (scripts/setup.ts) fills in the name and the resource ids.
// After changing bindings run `pnpm cf-types` to regenerate worker-configuration.d.ts.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saas-template",
  // Our entry wraps Astro's handler and adds the queue consumer and cron handler (src/worker.ts).
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "upload_source_maps": true,

  "vars": {
    "PUBLIC_APP_URL": "http://localhost:4321",
    "EMAIL_FROM_ADDRESS": "noreply@example.com",
    "PADDLE_ENV": "sandbox",
    "ADMIN_EMAILS": "",
    // Staff mailboxes on your domain, read and answered at /app/admin-mail (lib/server/admin-mail.ts),
    // comma-separated, e.g. "support@example.com,legal@example.com". Each needs an Email Routing rule
    // "Send to Worker"; incoming mail is also forwarded to ADMIN_MAIL_FORWARD (a verified destination).
    "ADMIN_MAILBOXES": "",
    "ADMIN_MAIL_FORWARD": ""
  },
  // Secrets (wrangler secret put …, locally in .dev.vars): BETTER_AUTH_SECRET, PADDLE_API_KEY,
  // PADDLE_WEBHOOK_SECRET, PUBLIC_PADDLE_CLIENT_TOKEN, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET.

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "saas-template",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "saas-template-files" }],
  "send_email": [{ "name": "EMAIL" }],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "saas-template-jobs" }],
    "consumers": [{ "queue": "saas-template-jobs", "max_retries": 5, "max_batch_size": 10 }]
  },
  "ratelimits": [
    // Public API: requests per API key per minute.
    { "name": "API_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    // Sign-in, sign-up and password reset: per client IP.
    { "name": "AUTH_RATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],
  "triggers": {
    // Daily housekeeping and trial reminders (see src/jobs/cron.ts).
    "crons": ["17 3 * * *"]
  }
}
